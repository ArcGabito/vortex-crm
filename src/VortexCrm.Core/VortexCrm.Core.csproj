<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lógica del CRM sin dependencias de UI: base local SQLite, contactos, oportunidades, cotizaciones (con su PDF) y
    tareas, sincronización con el hub y contratos de los eventos de la suite.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VortexCrm.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- PDFsharp trae System.Security.Cryptography.Pkcs 8.0.1, con vulnerabilidades conocidas: se fuerza la versión corregida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- SDK del hub desde el feed local (ver nuget.config y scripts/pack-sdk.*): siempre la versión más alta. -->
    <PackageReference Include="VortexApi.Client" Version="0.*-*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fuentes Open Sans (licencia OFL, ver Recursos/Fuentes/OFL.txt) para que el PDF salga igual en todas las plataformas -->
    <EmbeddedResource Include="Recursos\Fuentes\*.ttf" LogicalName="VortexCrm.Fuentes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VortexCrm.Core.Tests" />
  </ItemGroup>

</Project>
