@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav
@inject BackButton Back
@inject IJSRuntime JS

@if (Session.IsSignedIn)
{
    <div class="app">
        <div class="sidebar-backdrop @(_menuOpen ? "open" : "")" @onclick="() => _menuOpen = false"></div>
        <aside class="sidebar @(_menuOpen ? "open" : "")">
            <div class="brand"><Logo /></div>
            <nav class="nav" @onclick="() => _menuOpen = false">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="home" />@T("nav.panel")</NavLink>
                <NavLink class="nav-link" href="leads"><Icon Name="target" />@T("nav.leads")</NavLink>
                <NavLink class="nav-link" href="pipeline"><Icon Name="layers" />@T("nav.pipeline")</NavLink>
                <NavLink class="nav-link" href="pronostico"><Icon Name="arrows" />@T("nav.pronostico")</NavLink>
                <NavLink class="nav-link" href="reportes"><Icon Name="clipboard" />@T("nav.reportes")</NavLink>
                <NavLink class="nav-link" href="cotizaciones"><Icon Name="file" />@T("nav.cotizaciones")</NavLink>
                <NavLink class="nav-link" href="tareas">
                    <Icon Name="calendar" />@T("nav.tareas")
                    @if (_pendientes > 0)
                    {
                        <span class="count" title="@(T("nav.tareas_para_hoy_vencidas"))">@_pendientes</span>
                    }
                </NavLink>

                <div class="nav-section">@T("nav.clientes")</div>
                <NavLink class="nav-link" href="clientes"><Icon Name="briefcase" />@T("nav.clientes")</NavLink>
                <NavLink class="nav-link" href="contactos"><Icon Name="users" />@T("nav.contactos")</NavLink>
                <NavLink class="nav-link" href="equipo"><Icon Name="target" />@T("nav.equipo")</NavLink>

                <div class="nav-section">@T("nav.catalogo")</div>
                <NavLink class="nav-link" href="articulos"><Icon Name="tag" />@T("nav.productos_servicios")</NavLink>
                <NavLink class="nav-link" href="sedes"><Icon Name="store" />@T("nav.sedes")</NavLink>

                <div class="nav-section">@T("nav.sistema")</div>
                @if (Session.Can(CrmPermissions.ViewAudit))
                {
                    <NavLink class="nav-link" href="auditoria"><Icon Name="list" />@T("nav.auditoria")</NavLink>
                }
                <NavLink class="nav-link" href="configuracion"><Icon Name="settings" />@T("nav.configuracion")</NavLink>
            </nav>

            <div class="promo dark">
                <span class="promo-mark"><Icon Name="heart" Size="20" /></span>
                <h4>@T("nav.libre_de_codigo_abierto")</h4>
                <p>@T("nav.vortex_crm_es_agpl_3")</p>
                <button class="btn btn-block btn-sm" @onclick="OpenRepoAsync">@T("nav.contribuir")</button>
            </div>
        </aside>

        <div class="main">
            <TopBar OnMenu="() => _menuOpen = !_menuOpen" />
            <div class="content">
                <ErrorBoundary @ref="_boundary">
                    @Body
                </ErrorBoundary>
            </div>
        </div>
    </div>
}

@code {
    private bool _menuOpen;
    private int _pendientes;
    private ErrorBoundary? _boundary;
    private IDisposable? _back;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.DataChanged += OnDataChanged;
        Nav.LocationChanged += OnLocationChanged;
        _back = Back.Register(OnBack);
    }

    /// <summary>Atrás (Android): cierra el menú; fuera del panel vuelve a la página anterior; en el panel deja salir de la app.</summary>
    private bool OnBack()
    {
        if (_menuOpen)
        {
            _ = InvokeAsync(() => { _menuOpen = false; StateHasChanged(); });
            return true;
        }
        if (!Session.IsSignedIn || Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Length == 0)
            return false;
        _ = InvokeAsync(async () => await JS.InvokeVoidAsync("history.back"));
        return true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }
        await LoadCountsAsync();
    }

    private async Task LoadCountsAsync()
    {
        if (Session.Workspace is not { } crm)
            return;
        var panel = await crm.Clientes.PanelAsync();
        _pendientes = panel.TareasParaHoy + panel.TareasVencidas;
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (!Session.IsSignedIn)
            Nav.NavigateTo("login", replace: true);
        StateHasChanged();
    });

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadCountsAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _boundary?.Recover();

    private static Task OpenRepoAsync() => Launcher.Default.OpenAsync("https://github.com/ArcGabito/vortex-crm");

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.DataChanged -= OnDataChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _back?.Dispose();
    }
}
