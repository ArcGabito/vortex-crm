@page "/clientes"
@inherits CrmPage

<SectionContent SectionName="page-title">Clientes</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>Clientes</h2>
            <p>Un solo directorio para la suite: el ERP, el POS y el WMS ven los mismos clientes.</p>
        </div>
        <button class="btn btn-dark" @onclick="Abrir"><Icon Name="plus" Size="18" />Nuevo cliente</button>
    </div>

    <div class="filters">
        <div class="field search">
            <label>Buscar</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="Nombre, RUC/DNI o correo" value="@_busqueda" @oninput="BuscarAsync" />
            </div>
        </div>
    </div>

    @if (_resultado is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="briefcase" Title="No hay clientes" Text="Registra tu primer cliente: queda en el hub para toda la suite." />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>Cliente</th><th>Documento</th><th>Contacto</th><th>Ciudad</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in page.Items)
                        {
                            <tr @key="p.Id" style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"clientes/{p.Id}"))">
                                <td>
                                    <div class="cell-main">
                                        <Avatar Text="@p.Name" Size="34" />
                                        <div class="two-line"><span class="t1">@p.DisplayName</span><span class="t2">@(p.TradeName is null ? (p.Kind == "Person" ? "Persona" : "Empresa") : p.Name)</span></div>
                                    </div>
                                </td>
                                <td><div class="two-line"><span class="t1">@(p.DocumentNumber ?? "—")</span><span class="t2">@p.DocumentType</span></div></td>
                                <td><div class="two-line"><span class="t1" style="font-weight:600">@(p.Phone ?? "—")</span><span class="t2">@p.Email</span></div></td>
                                <td><span class="muted">@(p.City ?? "—")</span></td>
                                <td>
                                    @if (p.Pending)
                                    {
                                        <span class="tag" title="Guardado en este equipo; se enviará al hub al sincronizar">POR ENVIAR</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="clientes" OnPage="async p => { _pagina = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_form is { } f)
{
    <Modal Title="Nuevo cliente" Subtitle="Se registra en el hub y lo verán el ERP, el POS y el WMS." Size="lg" Error="@_error" OnClose="Cerrar">
        <ChildContent>
            <div class="segmented">
                <button class="@(f.Kind == "Company" ? "on" : "")" @onclick="@(() => { f.Kind = "Company"; f.DocumentType = "RUC"; })">Empresa</button>
                <button class="@(f.Kind == "Person" ? "on" : "")" @onclick="@(() => { f.Kind = "Person"; f.DocumentType = "DNI"; })">Persona</button>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@(f.Kind == "Company" ? "Razón social" : "Nombre completo")</label>
                    <input class="control" @bind="f.Name" />
                </div>
                @if (f.Kind == "Company")
                {
                    <div class="field">
                        <label>Nombre comercial (opcional)</label>
                        <input class="control" @bind="f.TradeName" />
                    </div>
                }
            </div>
            <div class="form-row three">
                <div class="field">
                    <label>Documento</label>
                    <select class="select" @bind="f.DocumentType">
                        <option value="">Sin documento</option>
                        <option value="RUC">RUC</option>
                        <option value="DNI">DNI</option>
                        <option value="CE">Carné de extranjería</option>
                        <option value="PAS">Pasaporte</option>
                    </select>
                </div>
                <div class="field">
                    <label>Número</label>
                    <input class="control" disabled="@(f.DocumentType == "")" inputmode="numeric" @bind="f.DocumentNumber"
                           placeholder="@(f.DocumentType switch { "RUC" => "11 dígitos", "DNI" => "8 dígitos", _ => "" })" />
                </div>
                <div class="field">
                    <label>Celular o teléfono</label>
                    <input class="control" type="tel" @bind="f.Phone" />
                </div>
            </div>
            <div class="form-row three">
                <div class="field">
                    <label>Correo</label>
                    <input class="control" type="email" @bind="f.Email" />
                </div>
                <div class="field">
                    <label>Dirección</label>
                    <input class="control" placeholder="Av. Larco 123" @bind="f.Address" />
                </div>
                <div class="field">
                    <label>Distrito</label>
                    <input class="control" placeholder="Miraflores" @bind="f.District" />
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>Ciudad</label>
                    <input class="control" placeholder="Lima" @bind="f.City" />
                </div>
                <div class="field">
                    <label>Notas (opcional)</label>
                    <input class="control" @bind="f.Notes" />
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Cerrar">Cancelar</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="GuardarAsync">Guardar cliente</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class ClienteForm
    {
        public string Kind { get; set; } = "Company";
        public string Name { get; set; } = "";
        public string? TradeName { get; set; }
        public string DocumentType { get; set; } = "RUC";
        public string? DocumentNumber { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? District { get; set; }
        public string? City { get; set; } = "Lima";
        public string? Notes { get; set; }
    }

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private PagedResult<PartyRow>? _resultado;
    private string _busqueda = "";
    private int _pagina = 1;
    private CancellationTokenSource? _debounce;
    private ClienteForm? _form;
    private string? _error;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        if (Query is not null && Query != _busqueda)
        {
            _busqueda = Query;
            _pagina = 1;
            await ReloadAsync();
        }
    }

    protected override async Task LoadAsync() =>
        _resultado = await Crm.Master.GetPartiesAsync(_busqueda, customers: true, suppliers: null, _pagina, 15);

    private async Task BuscarAsync(ChangeEventArgs e)
    {
        _busqueda = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _pagina = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void Abrir()
    {
        _error = null;
        _form = new ClienteForm();
    }

    private void Cerrar() => _form = null;

    private async Task GuardarAsync()
    {
        if (_form is not { } f)
            return;
        var doc = f.DocumentType == "" ? null : f.DocumentType;
        var draft = new PartyDraft(f.Name, f.Kind, true, false, doc, doc is null ? null : f.DocumentNumber?.Trim(), f.Email, f.Phone, f.City,
            AddressLine: f.Address, District: f.District, TradeName: f.Kind == "Company" ? f.TradeName : null, Notes: f.Notes);
        _busy = true;
        Guid id = default;
        _error = await TryAsync(async () => id = await Crm.Master.CreatePartyAsync(draft), $"{f.Name.Trim()} registrado.");
        _busy = false;
        if (_error is null)
        {
            _form = null;
            Nav.NavigateTo($"clientes/{id}");
        }
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
