@page "/clientes"
@inherits CrmPage

<SectionContent SectionName="page-title">@T("customers.clientes_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("customers.clientes_2")</h2>
            <p>@T("customers.un_solo_directorio_para_la")</p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            @if (Session.Can(CrmPermissions.MergeCustomers) && _duplicados.Count > 0)
            {
                <button class="btn btn-outline" @onclick="() => _verDuplicados = true"><Icon Name="users" Size="18" />@T("customers.duplicados_n", _duplicados.Count)</button>
            }
            @if (Session.Can(CrmPermissions.AssignCustomers))
            {
                <button class="btn btn-outline" @onclick="AbrirReasignar"><Icon Name="arrows" Size="18" />@T("customers.reasignar_cartera")</button>
            }
            @if (Session.Can(CrmPermissions.CreateCustomer))
            {
                <button class="btn btn-dark" @onclick="Abrir"><Icon Name="plus" Size="18" />@T("customers.nuevo_cliente")</button>
            }
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("customers.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("customers.nombre_ruc_dni_correo"))" value="@_busqueda" @oninput="BuscarAsync" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>@T("customers.cartera")</label>
            <div class="segmented">
                @foreach (var (valor, etiqueta) in Carteras)
                {
                    <button class="@(_cartera == valor ? "on" : "")" @onclick="async () => { _cartera = valor; _pagina = 1; await ReloadAsync(); }">@etiqueta</button>
                }
            </div>
        </div>
    </div>

    @if (_resultado is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="briefcase" Title="@(T("customers.no_hay_clientes"))" Text="@(T("customers.registra_tu_primer_cliente_queda"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>@T("customers.cliente")</th><th>@T("customers.documento")</th><th>@T("customers.contacto")</th><th>@T("customers.responsable")</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in page.Items)
                        {
                            <tr @key="p.Id" style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"clientes/{p.Id}"))">
                                <td>
                                    <div class="cell-main">
                                        <Avatar Text="@p.Name" Size="34" />
                                        <div class="two-line"><span class="t1">@p.DisplayName</span><span class="t2">@(p.TradeName is null ? (p.Kind == "Person" ? T("customers.persona") : T("customers.empresa")) : p.Name)</span></div>
                                    </div>
                                </td>
                                <td><div class="two-line"><span class="t1">@(p.DocumentNumber ?? "—")</span><span class="t2">@p.DocumentType</span></div></td>
                                <td><div class="two-line"><span class="t1" style="font-weight:600">@(p.Phone ?? "—")</span><span class="t2">@p.Email</span></div></td>
                                <td><div class="two-line"><span class="t1">@(p.OwnerName ?? T("customers.sin_responsable"))</span><span class="t2">@p.City</span></div></td>
                                <td>
                                    @if (!p.IsActive)
                                    {
                                        <span class="tag">@T("customers.inactivo")</span>
                                    }
                                    @if (p.Pending)
                                    {
                                        <span class="tag" title="@(T("customers.guardado_en_este_equipo_se"))">@T("customers.por_enviar")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("customers.clientes"))" OnPage="async p => { _pagina = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_form is { } f)
{
    <Modal Title="@(T("customers.nuevo_cliente"))" Subtitle="@(T("customers.se_registra_en_el_hub"))" Size="lg" Error="@_error" OnClose="Cerrar">
        <ChildContent>
            <div class="segmented">
                <button class="@(f.Kind == "Company" ? "on" : "")" @onclick="@(() => { f.Kind = "Company"; f.DocumentType = "RUC"; })">@T("customers.empresa")</button>
                <button class="@(f.Kind == "Person" ? "on" : "")" @onclick="@(() => { f.Kind = "Person"; f.DocumentType = "DNI"; })">@T("customers.persona")</button>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@(f.Kind == "Company" ? T("customers.razon_social") : T("customers.nombre_completo"))</label>
                    <input class="control" @bind="f.Name" />
                </div>
                @if (f.Kind == "Company")
                {
                    <div class="field">
                        <label>@T("customers.nombre_comercial_opcional")</label>
                        <input class="control" @bind="f.TradeName" />
                    </div>
                }
            </div>
            <div class="form-row three">
                <div class="field">
                    <label>@T("customers.documento")</label>
                    <select class="select" @bind="f.DocumentType">
                        <option value="">@T("customers.sin_documento")</option>
                        <option value="RUC">@T("customers.ruc")</option>
                        <option value="DNI">@T("customers.dni")</option>
                        <option value="CE">@T("customers.carne_de_extranjeria")</option>
                        <option value="PAS">@T("customers.pasaporte")</option>
                    </select>
                </div>
                <div class="field">
                    <label>@T("customers.numero")</label>
                    <input class="control" disabled="@(f.DocumentType == "")" inputmode="numeric" @bind="f.DocumentNumber"
                           placeholder="@(f.DocumentType switch { "RUC" => T("customers.11_digitos"), "DNI" => T("customers.8_digitos"), _ => "" })" />
                </div>
                <div class="field">
                    <label>@T("customers.celular_telefono")</label>
                    <input class="control" type="tel" @bind="f.Phone" />
                </div>
            </div>
            <div class="form-row three">
                <div class="field">
                    <label>@T("customers.correo")</label>
                    <input class="control" type="email" @bind="f.Email" />
                </div>
                <div class="field">
                    <label>@T("customers.direccion")</label>
                    <input class="control" placeholder="@(T("customers.av_larco_123"))" @bind="f.Address" />
                </div>
                <div class="field">
                    <label>@T("customers.distrito")</label>
                    <input class="control" placeholder="@(T("customers.miraflores"))" @bind="f.District" />
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@T("customers.ciudad")</label>
                    <input class="control" placeholder="@(T("customers.lima"))" @bind="f.City" />
                </div>
                <div class="field">
                    <label>@T("customers.notas_opcional")</label>
                    <input class="control" @bind="f.Notes" />
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Cerrar">@T("customers.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="GuardarAsync">@T("customers.guardar_cliente")</button>
        </Footer>
    </Modal>
}

@if (_reasignar)
{
    <Modal Title="@(T("customers.reasignar_cartera"))" Subtitle="@(T("customers.reasignar_explica"))" Size="sm" Error="@_error" OnClose="() => _reasignar = false">
        <ChildContent>
            <div class="field">
                <label>@T("customers.de")</label>
                <select class="select" @bind="_desde">
                    <option value="">@T("customers.elige")</option>
                    @foreach (var v in _vendedores)
                    {
                        <option value="@v.Id">@v.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>@T("customers.a")</label>
                <select class="select" @bind="_hasta">
                    <option value="">@T("customers.sin_responsable")</option>
                    @foreach (var v in _vendedores.Where(v => v.Id != _desde))
                    {
                        <option value="@v.Id">@v.Nombre</option>
                    }
                </select>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _reasignar = false">@T("customers.cancelar")</button>
            <button class="btn btn-dark" disabled="@(_busy || _desde is null)" @onclick="ReasignarAsync">@T("customers.reasignar")</button>
        </Footer>
    </Modal>
}

@if (_verDuplicados)
{
    <Modal Title="@(T("customers.clientes_duplicados"))" Subtitle="@(T("customers.duplicados_explica"))" Size="lg" Error="@_error" OnClose="() => _verDuplicados = false">
        <ChildContent>
            @if (_duplicados.Count == 0)
            {
                <EmptyState Icon="check" Title="@(T("customers.sin_duplicados"))" Text="@(T("customers.sin_duplicados_explica"))" />
            }
            @foreach (var g in _duplicados)
            {
                var principal = _principal.GetValueOrDefault(g.Valor, g.Clientes[0].Id);
                <div class="dup-group" @key="g.Valor">
                    <div class="dup-head"><span class="tag">@T($"customers.motivo.{g.Motivo}")</span><span class="muted">@g.Valor</span></div>
                    @foreach (var p in g.Clientes)
                    {
                        <label class="dup-row">
                            <input type="radio" name="@g.Valor" checked="@(p.Id == principal)" @onchange="() => _principal[g.Valor] = p.Id" />
                            <span class="two-line"><span class="t1">@p.Name</span><span class="t2">@(p.DocumentNumber is null ? T("customers.sin_documento") : $"{p.DocumentType} {p.DocumentNumber}")@(p.Email is null ? "" : $" · {p.Email}")@(p.Phone is null ? "" : $" · {p.Phone}")</span></span>
                            @if (p.Id == principal)
                            {
                                <span class="tag">@T("customers.se_queda")</span>
                            }
                        </label>
                    }
                    <div><button class="btn btn-sm btn-dark" disabled="@_busy" @onclick="() => FusionarAsync(g, principal)">@T("customers.fusionar_en_el_marcado")</button></div>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _verDuplicados = false">@T("customers.cerrar")</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class ClienteForm
    {
        public string Kind { get; set; } = "Company";
        public string Name { get; set; } = "";
        public string? TradeName { get; set; }
        public string DocumentType { get; set; } = "RUC";
        public string? DocumentNumber { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? District { get; set; }
        public string? City { get; set; } = "Lima";
        public string? Notes { get; set; }
    }

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private static (string Valor, string Etiqueta)[] Carteras => [("", T("customers.todos")), ("mine", T("customers.mis_clientes")), ("free", T("customers.sin_responsable"))];

    private PagedResult<PartyRow>? _resultado;
    private string _cartera = "";
    private IReadOnlyList<GrupoDuplicados> _duplicados = [];
    private readonly Dictionary<string, Guid> _principal = [];
    private bool _verDuplicados, _reasignar;
    private IReadOnlyList<Vendedor> _vendedores = [];
    private Guid? _desde, _hasta;
    private string _busqueda = "";
    private int _pagina = 1;
    private CancellationTokenSource? _debounce;
    private ClienteForm? _form;
    private string? _error;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        if (Query is not null && Query != _busqueda)
        {
            _busqueda = Query;
            _pagina = 1;
            await ReloadAsync();
        }
    }

    protected override async Task LoadAsync()
    {
        _resultado = await Crm.Master.GetPartiesAsync(_busqueda, customers: true, suppliers: null, _pagina, 15,
            owner: _cartera == "mine" ? Session.UserId : null, unassigned: _cartera == "free");
        if (Session.Can(CrmPermissions.MergeCustomers))
            _duplicados = await Crm.Cartera.DuplicadosAsync();
    }

    private async Task AbrirReasignar()
    {
        _error = null;
        _vendedores = await Crm.Cartera.VendedoresAsync();
        (_desde, _hasta) = (null, null);
        _reasignar = true;
    }

    private async Task ReasignarAsync()
    {
        if (_desde is not { } desde)
            return;
        var hasta = _vendedores.FirstOrDefault(v => v.Id == _hasta);
        _busy = true;
        var movidos = 0;
        _error = await TryAsync(async () => movidos = await Crm.Cartera.ReasignarCarteraAsync(desde, hasta?.Id, hasta?.Nombre));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("customers.cartera_reasignada", movidos));
            _reasignar = false;
            await ReloadAsync();
        }
    }

    private async Task FusionarAsync(GrupoDuplicados grupo, Guid principal)
    {
        _busy = true;
        var nombre = grupo.Clientes.First(p => p.Id == principal).Name;
        _error = await TryAsync(async () =>
        {
            foreach (var otro in grupo.Clientes.Where(p => p.Id != principal))
                await Crm.Cartera.FusionarAsync(principal, otro.Id);
        });
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("customers.fusionados_en", nombre));
            await ReloadAsync();
            _verDuplicados = _duplicados.Count > 0;
        }
    }

    private async Task BuscarAsync(ChangeEventArgs e)
    {
        _busqueda = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _pagina = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void Abrir()
    {
        _error = null;
        _form = new ClienteForm();
    }

    private void Cerrar() => _form = null;

    private async Task GuardarAsync()
    {
        if (_form is not { } f)
            return;
        var doc = f.DocumentType == "" ? null : f.DocumentType;
        var draft = new PartyDraft(f.Name, f.Kind, true, false, doc, doc is null ? null : f.DocumentNumber?.Trim(), f.Email, f.Phone, f.City,
            AddressLine: f.Address, District: f.District, TradeName: f.Kind == "Company" ? f.TradeName : null, Notes: f.Notes);
        _busy = true;
        Guid id = default;
        _error = await TryAsync(async () => id = await Crm.Master.CreatePartyAsync(draft), T("customers.registrado", f.Name.Trim()));
        _busy = false;
        if (_error is null)
        {
            _form = null;
            Nav.NavigateTo($"clientes/{id}");
        }
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
