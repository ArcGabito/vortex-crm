@page "/cotizaciones/nueva"
@page "/cotizaciones/{Id:guid}"
@inherits CrmPage
@using VortexCrm.Core.Domain.Segmentos
@inject FileExporter Exporter

<SectionContent SectionName="page-title">@T("quoteeditor.cotizacion")</SectionContent>

@if (_cotizacion is { } q)
{
    var editable = q.Estado is EstadoCotizacion.Borrador or EstadoCotizacion.Enviada;
    var totales = q.Totales;
    <div class="page">
        <div class="page-head">
            <div>
                <h2>@T("quoteeditor.cotizacion_2", q.Codigo)</h2>
                <p>
                    @{ var (text, tone) = StatusPill.ForEstado(q.Estado); }
                    <StatusPill Text="@text" Tone="@tone" />
                    @if (q.PedidoId is not null)
                    {
                        <StatusPill Text="@(T("quoteeditor.pedido_generado"))" Tone="good" />
                    }
                </p>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                @if (Id is not null)
                {
                    <button class="btn btn-outline" @onclick="WhatsAppAsync"><Icon Name="message" Size="18" />@T("quoteeditor.whatsapp")</button>
                    <button class="btn btn-outline" @onclick="CorreoAsync"><Icon Name="mail" Size="18" />@T("quoteeditor.correo")</button>
                    <button class="btn btn-outline" @onclick="PdfAsync"><Icon Name="download" Size="18" />@T("quoteeditor.pdf")</button>
                }
                @if (editable)
                {
                    <button class="btn btn-dark" disabled="@_busy" @onclick="GuardarAsync"><Icon Name="check" Size="18" />@T("quoteeditor.guardar")</button>
                }
            </div>
        </div>

        @if (editable && q.RequiereAprobacion(_ajustes.DescuentoMaximo))
        {
            <div class="alert warn">
                <Icon Name="alert" Size="18" />
                <div style="flex:1;display:flex;flex-direction:column;gap:8px">
                    <span>@T("quoteeditor.necesita_aprobacion", Pct(q.DescuentoMaximo), Pct(_ajustes.DescuentoMaximo ?? 0))</span>
                    @if (Session.Can(CrmPermissions.ApproveDiscounts))
                    {
                        <button class="btn btn-dark btn-sm" style="align-self:flex-start" disabled="@_busy" @onclick="AprobarAsync"><Icon Name="check" Size="16" />@T("quoteeditor.aprobar_descuento")</button>
                    }
                </div>
            </div>
        }
        else if (q.AprobadaPor is { } aprobo && q.DescuentoAprobado > 0)
        {
            <p class="muted" style="font-size:13px;margin:0">@T("quoteeditor.descuento_aprobado_por", Pct(q.DescuentoAprobado ?? 0), aprobo)</p>
        }

        @if (_error is not null)
        {
            <div class="alert error"><Icon Name="alert" Size="18" /><span>@_error</span></div>
        }

        <div class="grid-2">
            <div class="card">
                <div class="card-head"><h3>@T("quoteeditor.productos_servicios")</h3></div>
                <div class="card-body" style="display:flex;flex-direction:column;gap:14px">
                    @if (editable)
                    {
                        <ItemPicker Placeholder="@(T("quoteeditor.agrega_del_catalogo_por_nombre"))" OnSelected="AgregarArticulo" />
                        <div class="quote-tools">
                            @if (_plantillas.Count > 0)
                            {
                                <select class="select" value="" @onchange="UsarPlantillaAsync" aria-label="@(T("quoteeditor.usar_plantilla"))">
                                    <option value="">@T("quoteeditor.usar_plantilla")</option>
                                    @foreach (var p in _plantillas)
                                    {
                                        <option value="@p.Id">@p.Nombre (@p.Productos.Count)</option>
                                    }
                                </select>
                            }
                            <button class="btn btn-sm btn-ghost" disabled="@(q.Lineas.All(l => l.EstaVacia))" @onclick="AbrirPlantilla"><Icon Name="copy" Size="16" />@T("quoteeditor.guardar_como_plantilla")</button>
                        </div>
                        @if (_lista.Nombre is { } nombreLista)
                        {
                            <span class="hint">@T("quoteeditor.precios_de_la_lista", nombreLista)</span>
                        }
                    }
                    <div class="quote-lines">
                        <div class="quote-line head"><span>@T("quoteeditor.descripcion")</span><span>@T("quoteeditor.cantidad")</span><span>@T("quoteeditor.unidad")</span><span>@T("quoteeditor.unitario")</span><span style="text-align:right">@T("quoteeditor.importe")</span><span></span></div>
                        @foreach (var linea in q.Lineas)
                        {
                            <div class="quote-item @(linea.Opcional ? "optional" : "")" @key="linea">
                                <div class="quote-line">
                                    <input class="control" placeholder="@(T("quoteeditor.descripcion"))" disabled="@(!editable)" @bind="linea.Descripcion" />
                                    <input class="control" type="number" min="0" step="any" disabled="@(!editable)" @bind="linea.Cantidad" @bind:event="onchange" @bind:after="RepreciarAsync" aria-label="@(T("quoteeditor.cantidad"))" />
                                    <input class="control" disabled="@(!editable)" @bind="linea.Unidad" aria-label="@(T("quoteeditor.unidad"))" />
                                    <input class="control" type="number" min="0" step="0.01" disabled="@(!editable)" @bind="linea.PrecioUnitario" @bind:event="oninput" aria-label="@(T("quoteeditor.unitario"))" />
                                    <span class="amount">@Fmt.Money(linea.Importe, q.Moneda)</span>
                                    @if (editable)
                                    {
                                        <button class="btn btn-ghost icon-btn sm" @onclick="() => q.Lineas.Remove(linea)" aria-label="@(T("quoteeditor.quitar"))"><Icon Name="x" Size="16" /></button>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                </div>
                                @if (!linea.EstaVacia)
                                {
                                    <div class="quote-line-meta">
                                        @if (linea.PrecioLista is { } lista && lista != linea.PrecioUnitario)
                                        {
                                            <span class="@(linea.Descuento > (_ajustes.DescuentoMaximo ?? 100) ? "warn-text" : "")">
                                                @T("quoteeditor.lista_y_descuento", Fmt.Money(lista, q.Moneda), Pct(linea.Descuento))
                                            </span>
                                        }
                                        <label class="check-row">
                                            <input type="checkbox" disabled="@(!editable)" @bind="linea.Opcional" />
                                            <span>@T("quoteeditor.opcional")</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (editable)
                    {
                        <button class="btn btn-sm btn-ghost" style="align-self:flex-start" @onclick="() => q.Lineas.Add(new LineaCotizacion())"><Icon Name="plus" Size="16" />@T("quoteeditor.linea_libre")</button>
                    }
                    <dl class="totals" style="max-width:340px;margin-left:auto;width:100%">
                        @if (q.ModoIgv != ModoIgv.NoAplica)
                        {
                            <dt>@T("quoteeditor.subtotal")</dt><dd>@Fmt.Money(totales.Subtotal, q.Moneda)</dd>
                            <dt>@q.NombreImpuesto (@((q.TasaImpuesto * 100).ToString("0.##", Fmt.Culture)) %)</dt><dd>@Fmt.Money(totales.Igv, q.Moneda)</dd>
                        }
                        <dt class="grand">@T("quoteeditor.total")</dt><dd class="grand">@Fmt.Money(totales.Total, q.Moneda)</dd>
                        @if (q.Lineas.Any(l => l.Opcional))
                        {
                            <dt class="muted">@T("quoteeditor.opcionales_no_suman")</dt><dd class="muted">@Fmt.Money(q.TotalOpcionales, q.Moneda)</dd>
                        }
                    </dl>
                    <p class="muted" style="font-size:12px;text-align:right">@MontoEnLetras.Monto(totales.Total, q.Moneda)</p>
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
                <div class="card">
                    <div class="card-head"><h3>@T("quoteeditor.datos")</h3></div>
                    <div class="card-body" style="display:flex;flex-direction:column;gap:14px">
                        <div class="field">
                            <label>@T("quoteeditor.cliente")</label>
                            <select class="select" disabled="@(!editable)" value="@q.ClienteId" @onchange="ElegirClienteAsync">
                                <option value="">@T("quoteeditor.elige_un_cliente")</option>
                                @foreach (var c in _clientes)
                                {
                                    <option value="@c.Id">@c.Label@(c.Detail is null ? "" : $" · {c.Detail}")</option>
                                }
                            </select>
                        </div>
                        <div class="form-row">
                            <div class="field">
                                <label>@T("quoteeditor.la_atencion_de")</label>
                                <select class="select" disabled="@(!editable)" @bind="q.ContactoId">
                                    <option value="">@T("quoteeditor.nadie_en_particular")</option>
                                    @foreach (var c in _contactos)
                                    {
                                        <option value="@c.Id">@c.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>@T("quoteeditor.oportunidad")</label>
                                <select class="select" disabled="@(!editable)" @bind="q.OportunidadId">
                                    <option value="">@T("quoteeditor.sin_oportunidad")</option>
                                    @foreach (var o in _oportunidades)
                                    {
                                        <option value="@o.Id">@o.Label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="field">
                                <label>@T("quoteeditor.emision")</label>
                                <input class="control" type="date" disabled="@(!editable)" @bind="q.FechaEmision" />
                            </div>
                            <div class="field">
                                <label>@T("quoteeditor.valida_hasta")</label>
                                <input class="control" type="date" disabled="@(!editable)" @bind="q.ValidaHasta" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="field">
                                <label>@q.NombreImpuesto</label>
                                <select class="select" disabled="@(!editable)" @bind="q.ModoIgv" @bind:after="RepreciarAsync">
                                    @foreach (var m in Enum.GetValues<ModoIgv>())
                                    {
                                        <option value="@m">@Fmt.TaxMode(m, q.NombreImpuesto, q.TasaImpuesto)</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>@T("quoteeditor.moneda")</label>
                                <select class="select" disabled="@(!editable)" @bind="q.Moneda" @bind:after="RepreciarAsync">
                                    @foreach (var currency in VortexApi.Suite.Money.Currencies.List)
                                    {
                                        <option value="@currency.Code">@currency.Code · @currency.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>@T("quoteeditor.sede_que_emite")</label>
                                <select class="select" disabled="@(!editable)" @bind="q.SedeId" @bind:after="RepreciarAsync">
                                    <option value="">@T("quoteeditor.domicilio_fiscal")</option>
                                    @foreach (var s in _sedes)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="field">
                            <label>@T("quoteeditor.condiciones")</label>
                            <textarea class="control" rows="3" disabled="@(!editable)" placeholder="@(T("quoteeditor.forma_de_pago_tiempo_de"))" @bind="q.Condiciones"></textarea>
                        </div>
                    </div>
                </div>

                @if (Id is not null)
                {
                    <div class="card">
                        <div class="card-head"><h3>@T("quoteeditor.siguiente_paso")</h3></div>
                        <div class="card-body" style="display:flex;flex-direction:column;gap:10px">
                            @switch (q.Estado)
                            {
                                case EstadoCotizacion.Borrador:
                                    <button class="btn btn-block" @onclick="() => CambiarAsync(EstadoCotizacion.Enviada)"><Icon Name="send" Size="18" />@T("quoteeditor.marcar_como_enviada")</button>
                                    <button class="btn btn-block btn-ghost" @onclick="EliminarAsync"><Icon Name="trash" Size="18" />@T("quoteeditor.eliminar_borrador")</button>
                                    break;
                                case EstadoCotizacion.Enviada:
                                    <button class="btn btn-block btn-dark" @onclick="() => CambiarAsync(EstadoCotizacion.Aceptada)"><Icon Name="check" Size="18" />@T("quoteeditor.el_cliente_acepto")</button>
                                    <button class="btn btn-block btn-danger" @onclick="() => CambiarAsync(EstadoCotizacion.Rechazada)"><Icon Name="x" Size="18" />@T("quoteeditor.el_cliente_rechazo")</button>
                                    <button class="btn btn-block" @onclick="NuevaVersionAsync"><Icon Name="copy" Size="18" />@T("quoteeditor.nueva_version")</button>
                                    <p class="muted" style="font-size:12.5px;margin:0">@T("quoteeditor.nueva_version_explica")</p>
                                    break;
                                case EstadoCotizacion.Rechazada:
                                    <p class="muted" style="font-size:13px">@T("quoteeditor.cotizacion_rechazada_puedes_crear_una")</p>
                                    <button class="btn btn-block" @onclick="NuevaVersionAsync"><Icon Name="copy" Size="18" />@T("quoteeditor.nueva_version")</button>
                                    break;
                                case EstadoCotizacion.Reemplazada:
                                    <p class="muted" style="font-size:13px">@T("quoteeditor.reemplazada")</p>
                                    break;
                                case EstadoCotizacion.Aceptada when q.PedidoId is null:
                                    <p class="muted" style="font-size:13px">@T("quoteeditor.el_erp_ya_la_ve")</p>
                                    <button class="btn btn-block btn-dark" @onclick="PedidoAsync"><Icon Name="truck" Size="18" />@T("quoteeditor.generar_pedido")</button>
                                    break;
                                case EstadoCotizacion.Aceptada:
                                    <p class="muted" style="font-size:13px">@T("quoteeditor.pedido_generado_su_avance_despacho")</p>
                                    break;
                                default:
                                    <p class="muted" style="font-size:13px">@T("quoteeditor.cotizacion_rechazada_puedes_crear_una")</p>
                                    break;
                            }
                            @if (q.Estado is EstadoCotizacion.Borrador or EstadoCotizacion.Enviada)
                            {
                                <div class="online-accept">
                                    <span class="field-label">@T("quoteeditor.aceptacion_en_linea")</span>
                                    @if (q.EnlaceUrl is { } url)
                                    {
                                        <input class="control" readonly value="@url" aria-label="@(T("quoteeditor.aceptacion_en_linea"))" />
                                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                                            <button class="btn btn-sm" @onclick="() => CopiarEnlaceAsync(url)"><Icon Name="copy" Size="16" />@T("quoteeditor.copiar_enlace")</button>
                                            <button class="btn btn-sm btn-ghost" @onclick="() => Launcher.Default.OpenAsync(new Uri(url))"><Icon Name="external" Size="16" />@T("quoteeditor.abrir_enlace")</button>
                                        </div>
                                        <span class="muted" style="font-size:12.5px">
                                            @(_enlace switch
                                            {
                                                null => T("quoteeditor.enlace_sin_estado"),
                                                { Status: VortexApi.Client.VortexPublicLinkStatus.Revoked } => T("quoteeditor.enlace_retirado"),
                                                { ViewCount: 0 } => T("quoteeditor.enlace_no_visto"),
                                                var visto => T("quoteeditor.enlace_visto", visto.ViewCount, Fmt.DateTime(visto.LastViewedAt!.Value)),
                                            })
                                        </span>
                                    }
                                    else
                                    {
                                        <p class="muted" style="font-size:12.5px;margin:0">@T("quoteeditor.enlace_explica")</p>
                                    }
                                    <button class="btn btn-block" disabled="@_busy" @onclick="EnlaceAsync"><Icon Name="external" Size="18" />@(q.EnlaceUrl is null ? T("quoteeditor.crear_enlace") : T("quoteeditor.actualizar_enlace"))</button>
                                </div>
                            }
                            else if (q.FirmadaEn is { } firmadaEn)
                            {
                                <div class="online-accept">
                                    <span class="field-label">@T("quoteeditor.aceptacion_en_linea")</span>
                                    <span>@T(q.Estado == EstadoCotizacion.Rechazada ? "quoteeditor.rechazada_en_linea_por" : "quoteeditor.aceptada_en_linea_por", q.FirmadaPor ?? "—", Fmt.DateTime(firmadaEn))</span>
                                    @if (q.RespuestaCliente is { } comentario)
                                    {
                                        <span class="muted" style="font-size:13px">“@comentario”</span>
                                    }
                                    @if (_enlace?.Signature is { } firma)
                                    {
                                        <img class="signature" src="@firma" alt="@(T("quoteeditor.firma_del_cliente"))" />
                                    }
                                </div>
                            }
                            @if (_versiones.Count > 1)
                            {
                                <div class="versions">
                                    <span class="field-label">@T("quoteeditor.versiones")</span>
                                    @foreach (var v in _versiones)
                                    {
                                        var (vt, vtone) = StatusPill.ForEstado(v.Estado);
                                        <a class="list-row @(v.Id == q.Id ? "on" : "")" href="@($"cotizaciones/{v.Id}")">
                                            <span style="flex:1">v@(v.Version) · @Fmt.Date(v.Fecha)</span>
                                            <StatusPill Text="@vt" Tone="@vtone" />
                                        </a>
                                    }
                                </div>
                            }
                            @if (q.ClienteId is { } cliente)
                            {
                                <a class="btn btn-block btn-ghost" href="@($"clientes/{cliente}")"><Icon Name="briefcase" Size="18" />@T("quoteeditor.ver_ficha_del_cliente")</a>
                            }
                        </div>
                    </div>
                    <CamposPersonalizados Entidad="@EntidadesCampo.Cotizacion" RegistroId="q.Id" />
                }
            </div>
        </div>
    </div>

    @if (_nombrePlantilla is not null)
    {
        <Modal Title="@(T("quoteeditor.guardar_como_plantilla"))" Subtitle="@(T("quoteeditor.plantilla_explica"))" Size="sm" Error="@_error" OnClose="() => _nombrePlantilla = null">
            <ChildContent>
                <div class="field">
                    <label>@T("quoteeditor.nombre_de_la_plantilla")</label>
                    <input class="control" @bind="_nombrePlantilla" />
                </div>
            </ChildContent>
            <Footer>
                <button class="btn" @onclick="() => _nombrePlantilla = null">@T("quoteeditor.cancelar")</button>
                <button class="btn btn-dark" disabled="@_busy" @onclick="GuardarPlantillaAsync">@T("quoteeditor.guardar")</button>
            </Footer>
        </Modal>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "cliente")] public Guid? ClienteQuery { get; set; }
    [SupplyParameterFromQuery(Name = "oportunidad")] public Guid? OportunidadQuery { get; set; }

    private Cotizacion? _cotizacion;
    private IReadOnlyList<Option> _clientes = [], _contactos = [], _oportunidades = [];
    private IReadOnlyList<SiteRow> _sedes = [];
    private IReadOnlyList<PlantillaCotizacionVista> _plantillas = [];
    private IReadOnlyList<(Guid Id, int Version, EstadoCotizacion Estado, DateOnly Fecha)> _versiones = [];
    private Ajustes _ajustes = new(ModoIgv.Incluido, null);
    private ListaPrecios _lista = ListaPrecios.Ninguna;
    private VortexApi.Client.VortexPublicLink? _enlace;
    private string? _error, _nombrePlantilla;
    private bool _busy;

    private static string Pct(decimal valor) => valor.ToString("0.##", Fmt.Culture) + " %";

    protected override async Task LoadAsync()
    {
        // Mientras se edita no se pisa lo escrito con lo que llegue de la sincronización.
        if (_cotizacion is null || (Id is { } id && _cotizacion.Id == id && _cotizacion.Estado is not (EstadoCotizacion.Borrador or EstadoCotizacion.Enviada)))
        {
            _cotizacion = Id is { } existente
                ? await Crm.Cotizaciones.ObtenerAsync(existente)
                : await Crm.Cotizaciones.NuevaAsync(ClienteQuery, OportunidadQuery);
            if (_cotizacion is null)
            {
                Nav.NavigateTo("cotizaciones", replace: true);
                return;
            }
        }
        else if (Id is { } abierta && await Crm.Cotizaciones.ObtenerAsync(abierta) is { } guardada && guardada.Estado != _cotizacion.Estado)
        {
            // El cliente la aceptó o rechazó desde el enlace (o la cambió otro equipo) mientras estaba abierta.
            _cotizacion = guardada;
        }
        _ = CargarEnlaceAsync(_cotizacion);
        _ajustes = await Crm.Clientes.ObtenerAjustesAsync();
        _plantillas = await Crm.Cotizaciones.PlantillasAsync();
        _versiones = await Crm.Cotizaciones.VersionesAsync(_cotizacion);
        if (_cotizacion.Estado is EstadoCotizacion.Borrador or EstadoCotizacion.Enviada)
            _lista = await Crm.Cotizaciones.ListaPreciosAsync(_cotizacion.ClienteId, _cotizacion.SedeId, _cotizacion.Moneda);
        _clientes = await Crm.Master.GetPartyOptionsAsync(suppliers: false);
        _sedes = await Crm.Master.GetSitesAsync(activeOnly: true);
        await CargarRelacionadosAsync();
    }

    private async Task CargarRelacionadosAsync()
    {
        var cliente = _cotizacion?.ClienteId;
        _contactos = cliente is null ? [] : await Crm.Contactos.OpcionesAsync(cliente);
        _oportunidades = cliente is null ? [] : await Crm.Oportunidades.OpcionesAsync(cliente);
    }

    private async Task ElegirClienteAsync(ChangeEventArgs e)
    {
        _cotizacion!.ClienteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        _cotizacion.ContactoId = null;
        _cotizacion.OportunidadId = null;
        await CargarRelacionadosAsync();
        await RepreciarAsync();
    }

    private void AgregarArticulo(ItemRow item) => _cotizacion!.AgregarLinea(item.CrearLinea(_cotizacion, 1, _lista));

    /// <summary>Precio de lista según el cliente, la cantidad, la moneda y el impuesto (lo puesto a mano se conserva).</summary>
    private async Task RepreciarAsync()
    {
        if (_cotizacion is { Estado: EstadoCotizacion.Borrador or EstadoCotizacion.Enviada } q)
            _lista = await Crm.Cotizaciones.RepreciarAsync(q);
    }

    private async Task UsarPlantillaAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _error = await TryAsync(() => Crm.Cotizaciones.AplicarPlantillaAsync(_cotizacion!, id));
    }

    private void AbrirPlantilla() => (_nombrePlantilla, _error) = (_cotizacion?.Lineas.FirstOrDefault()?.Descripcion ?? "", null);

    private async Task GuardarPlantillaAsync()
    {
        _busy = true;
        var nombre = _nombrePlantilla ?? "";
        _error = await TryAsync(() => Crm.Cotizaciones.GuardarPlantillaAsync(nombre, _cotizacion!), T("quoteeditor.plantilla_guardada", nombre));
        _busy = false;
        if (_error is null)
        {
            _nombrePlantilla = null;
            _plantillas = await Crm.Cotizaciones.PlantillasAsync();
        }
    }

    private async Task AprobarAsync()
    {
        if (!await GuardarAsync())
            return;
        _error = await TryAsync(() => Crm.Cotizaciones.AprobarDescuentoAsync(_cotizacion!.Id), T("quoteeditor.descuento_aprobado"));
        _cotizacion = await Crm.Cotizaciones.ObtenerAsync(_cotizacion!.Id);
    }

    private async Task NuevaVersionAsync()
    {
        Guid nueva = default;
        _error = await TryAsync(async () => nueva = await Crm.Cotizaciones.NuevaVersionAsync(_cotizacion!.Id));
        if (_error is null)
        {
            Toasts.Success(T("quoteeditor.version_creada"));
            _cotizacion = null;
            Nav.NavigateTo($"cotizaciones/{nueva}");
        }
    }

    /// <summary>Vistas, respuesta y firma del enlace (desde el hub, sin trabar la pantalla si no hay conexión).</summary>
    private async Task CargarEnlaceAsync(Cotizacion cotizacion)
    {
        if (cotizacion.EnlaceId is null)
        {
            _enlace = null;
            return;
        }
        var enlace = await Crm.Cotizaciones.EstadoEnlaceAsync(cotizacion);
        await InvokeAsync(() =>
        {
            _enlace = enlace;
            StateHasChanged();
        });
    }

    private async Task EnlaceAsync()
    {
        if (!await GuardarAsync())
            return;
        _busy = true;
        string? url = null;
        _error = await TryAsync(async () => url = await Crm.Cotizaciones.EnlaceParaAceptarAsync(_cotizacion!.Id), T("quoteeditor.enlace_listo"));
        _busy = false;
        _cotizacion = await Crm.Cotizaciones.ObtenerAsync(_cotizacion!.Id);
        if (_error is null && url is not null)
        {
            await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(url);
            _ = CargarEnlaceAsync(_cotizacion!);
        }
    }

    private async Task CopiarEnlaceAsync(string url)
    {
        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default.SetTextAsync(url);
        Toasts.Success(T("quoteeditor.enlace_copiado"));
    }

    private async Task<bool> GuardarAsync()
    {
        _busy = true;
        string? codigo = null;
        _error = await TryAsync(async () => codigo = await Crm.Cotizaciones.GuardarAsync(_cotizacion!));
        _busy = false;
        if (_error is not null)
            return false;
        Toasts.Success(T("quoteeditor.cotizacion_guardada", codigo));
        if (Id is null)
            Nav.NavigateTo($"cotizaciones/{_cotizacion!.Id}", replace: true);
        return true;
    }

    private async Task CambiarAsync(EstadoCotizacion estado)
    {
        if (_cotizacion!.Estado is EstadoCotizacion.Borrador or EstadoCotizacion.Enviada && !await GuardarAsync())
            return;
        _error = await TryAsync(() => Crm.Cotizaciones.CambiarEstadoAsync(_cotizacion.Id, estado), estado switch
        {
            EstadoCotizacion.Aceptada => T("quoteeditor.cotizacion_aceptada_el_erp_ya"),
            EstadoCotizacion.Enviada => T("quoteeditor.cotizacion_marcada_como_enviada"),
            _ => T("quoteeditor.cotizacion_marcada_como_rechazada"),
        });
        _cotizacion = await Crm.Cotizaciones.ObtenerAsync(_cotizacion.Id);
    }

    private async Task PedidoAsync()
    {
        string? numero = null;
        _error = await TryAsync(async () => numero = await Crm.Cotizaciones.GenerarPedidoAsync(_cotizacion!.Id));
        if (_error is null)
        {
            Toasts.Success(T("quoteeditor.pedido_enviado_la_suite", numero));
            _cotizacion = await Crm.Cotizaciones.ObtenerAsync(_cotizacion!.Id);
        }
    }

    private async Task EliminarAsync()
    {
        _error = await TryAsync(() => Crm.Cotizaciones.EliminarAsync(_cotizacion!.Id), T("quoteeditor.borrador_eliminado"));
        if (_error is null)
            Nav.NavigateTo("cotizaciones", replace: true);
    }

    private async Task WhatsAppAsync()
    {
        if (_cotizacion!.Estado is EstadoCotizacion.Borrador or EstadoCotizacion.Enviada && !await GuardarAsync())
            return;
        var (_, enlace) = await Crm.Cotizaciones.WhatsAppAsync(_cotizacion.Id);
        if (enlace is null)
            Toasts.Error(T("quoteeditor.el_cliente_el_contacto_no"));
        else
            await Launcher.Default.OpenAsync(new Uri(enlace));
    }

    /// <summary>
    /// Abre el correo del equipo con la cotización en PDF adjunta (en Android y Windows). Si el equipo no permite adjuntar,
    /// guarda el PDF y abre un correo sin adjunto. Queda registrado en la ficha del cliente.
    /// </summary>
    private async Task CorreoAsync()
    {
        if (_cotizacion!.Estado is EstadoCotizacion.Borrador or EstadoCotizacion.Enviada && !await GuardarAsync())
            return;
        try
        {
            var (para, asunto, cuerpo) = await Crm.Cotizaciones.CorreoAsync(_cotizacion.Id);
            var pdf = await Crm.Cotizaciones.GenerarPdfAsync(_cotizacion.Id);
            var archivo = Path.Combine(FileSystem.CacheDirectory, $"{_cotizacion.Codigo}.pdf");
            await File.WriteAllBytesAsync(archivo, pdf);
            try
            {
                var correo = new EmailMessage { Subject = asunto, Body = cuerpo, To = para is null ? [] : [para] };
                correo.Attachments!.Add(new EmailAttachment(archivo));
                await Email.Default.ComposeAsync(correo);
            }
            catch (Exception ex) when (ex is FeatureNotSupportedException or NotImplementedException or InvalidOperationException)
            {
                await Exporter.ExportBytesAsync($"{_cotizacion.Codigo}.pdf", pdf, "application/pdf");
                await Launcher.Default.OpenAsync(new Uri($"mailto:{para}?subject={Uri.EscapeDataString(asunto)}&body={Uri.EscapeDataString(cuerpo)}"));
            }
            await Crm.Cotizaciones.RegistrarEnvioPorCorreoAsync(_cotizacion.Id, para);
            Toasts.Success(T("quoteeditor.correo_listo"));
        }
        catch (CrmValidationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PdfAsync()
    {
        if (_cotizacion!.Estado is EstadoCotizacion.Borrador or EstadoCotizacion.Enviada && !await GuardarAsync())
            return;
        try
        {
            var pdf = await Crm.Cotizaciones.GenerarPdfAsync(_cotizacion.Id);
            await Exporter.ExportBytesAsync($"{_cotizacion.Codigo}.pdf", pdf, "application/pdf");
        }
        catch (CrmValidationException ex)
        {
            _error = ex.Message;
        }
    }
}
