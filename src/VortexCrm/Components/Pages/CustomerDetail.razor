@page "/clientes/{Id:guid}"
@inherits CrmPage
@using VortexCrm.Core.Domain.Segmentos

<SectionContent SectionName="page-title">@T("customerdetail.cliente")</SectionContent>

@if (_ficha is { } f)
{
    var c = f.Cliente;
    <div class="page">
        <div class="page-head">
            <div class="cell-main">
                <Avatar Text="@c.Name" Size="52" Class="square" />
                <div>
                    <h2>@c.DisplayName</h2>
                    <p>@(c.DocumentNumber is null ? "" : $"{c.DocumentType} {c.DocumentNumber} · ")@(c.FullAddress ?? T("customerdetail.sin_direccion"))</p>
                    <div class="owner-line">
                        <Icon Name="user" Size="15" />
                        <span>@T("customerdetail.responsable", c.OwnerName ?? T("customerdetail.sin_responsable"))</span>
                        @if (Session.Can(CrmPermissions.AssignCustomers))
                        {
                            <button class="link-btn" @onclick="AbrirAsignar">@T("customerdetail.cambiar")</button>
                        }
                        else if (c.OwnerId is null && Session.Can(CrmPermissions.Sell))
                        {
                            <button class="link-btn" @onclick="() => AsignarAsync(Session.UserId, Session.UserName)">@T("customerdetail.tomar_cliente")</button>
                        }
                        else if (c.OwnerId is { } duenio && duenio == Session.UserId)
                        {
                            <button class="link-btn" @onclick="() => AsignarAsync(null, null)">@T("customerdetail.soltar")</button>
                        }
                    </div>
                </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                @if (TelefonoPeru.ParaWhatsApp(c.Phone) is not null)
                {
                    <button class="btn btn-outline" @onclick="() => Mensaje(CanalPlantilla.WhatsApp, c.Phone, null)"><Icon Name="message" Size="18" />@T("customerdetail.whatsapp")</button>
                }
                @if (!string.IsNullOrWhiteSpace(c.Email))
                {
                    <button class="btn btn-outline" @onclick="() => Mensaje(CanalPlantilla.Correo, null, null)"><Icon Name="mail" Size="18" />@T("customerdetail.correo")</button>
                }
                <button class="btn btn-outline" @onclick="NuevaInteraccion"><Icon Name="phone" Size="18" />@T("customerdetail.registrar")</button>
                <button class="btn btn-outline" @onclick="NuevaTarea"><Icon Name="calendar" Size="18" />@T("customerdetail.tarea")</button>
                <button class="btn btn-outline" @onclick="NuevaOportunidad"><Icon Name="target" Size="18" />@T("customerdetail.oportunidad")</button>
                <a class="btn btn-dark" href="@($"cotizaciones/nueva?cliente={c.Id}")"><Icon Name="file" Size="18" />@T("customerdetail.cotizar")</a>
            </div>
        </div>

        <div class="stat-strip boxed">
            <StatTile Icon="target" Label="@(T("customerdetail.en_curso"))" Value="@Fmt.Amount(f.Oportunidades.Where(o => o.Oportunidad.Etapa.EstaAbierta()).Sum(o => o.Oportunidad.Monto))" Hint="@Fmt.Count(f.Oportunidades.Count(o => o.Oportunidad.Etapa.EstaAbierta()), T("count.oportunidad"), T("count.oportunidades"))" />
            <StatTile Icon="star" Label="@(T("customerdetail.ganado"))" Value="@Fmt.Amount(f.Oportunidades.Where(o => o.Oportunidad.Etapa == EtapaOportunidad.Ganado).Sum(o => o.Oportunidad.Monto))" />
            <StatTile Icon="receipt" Label="@(T("customerdetail.facturado"))" Value="@Fmt.Amount(f.Actividad.Where(a => a.Tipo == TiposActividad.Comprobante).Sum(a => a.Monto ?? 0))" Hint="@(T("customerdetail.segun_el_erp"))" />
            <StatTile Icon="wallet" Label="@(T("customerdetail.pagado"))" Value="@Fmt.Amount(f.Actividad.Where(a => a.Tipo == TiposActividad.Cobro).Sum(a => a.Monto ?? 0))" Hint="@(T("customerdetail.segun_el_erp"))" />
        </div>

        <div class="grid-2">
            <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
                <div class="card">
                    <div class="card-head"><h3>@T("customerdetail.oportunidades")</h3><button class="btn btn-sm" @onclick="NuevaOportunidad"><Icon Name="plus" Size="16" />@T("customerdetail.nueva")</button></div>
                    <div class="card-body">
                        @if (f.Oportunidades.Count == 0)
                        {
                            <div class="list-row"><span class="muted">@T("customerdetail.sin_oportunidades")</span></div>
                        }
                        @foreach (var v in f.Oportunidades)
                        {
                            var (text, tone) = StatusPill.ForEtapa(v.Oportunidad.Etapa);
                            <div class="list-row" style="cursor:pointer" @onclick="() => EditarOportunidad(v.Oportunidad)">
                                <div class="two-line" style="flex:1"><span class="t1">@v.Oportunidad.Titulo</span><span class="t2">@(v.Contacto is { Length: > 0 } k ? k : T("customerdetail.sin_contacto"))</span></div>
                                <StatusPill Text="@text" Tone="@tone" />
                                <strong class="end">@Fmt.Amount(v.Oportunidad.Monto)</strong>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-head"><h3>@T("customerdetail.cotizaciones")</h3><a class="btn btn-sm" href="@($"cotizaciones/nueva?cliente={c.Id}")"><Icon Name="plus" Size="16" />@T("customerdetail.nueva")</a></div>
                    <div class="card-body">
                        @if (f.Cotizaciones.Count == 0)
                        {
                            <div class="list-row"><span class="muted">@T("customerdetail.sin_cotizaciones")</span></div>
                        }
                        @foreach (var q in f.Cotizaciones)
                        {
                            var (text, tone) = StatusPill.ForCotizacion(q, Fmt.Today);
                            <a class="list-row" href="@($"cotizaciones/{q.Id}")">
                                <div class="two-line" style="flex:1"><span class="t1">@q.Codigo</span><span class="t2">@Fmt.Date(q.FechaEmision)</span></div>
                                <StatusPill Text="@text" Tone="@tone" />
                                <strong class="end">@Fmt.Money(q.Total, q.Moneda)</strong>
                            </a>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-head"><h3>@T("customerdetail.interacciones")</h3><button class="btn btn-sm" @onclick="NuevaInteraccion"><Icon Name="plus" Size="16" />@T("customerdetail.registrar")</button></div>
                    <div class="card-body">
                        @if (_interacciones.Count == 0)
                        {
                            <div class="list-row"><span class="muted">@T("customerdetail.sin_interacciones")</span></div>
                        }
                        @foreach (var vi in _interacciones)
                        {
                            var i = vi.Interaccion;
                            <div class="list-row interaction" @key="i.Id" style="cursor:pointer" @onclick="() => EditarInteraccion(i)">
                                <div class="stat-icon" style="width:32px;height:32px;border-radius:10px"><Icon Name="@InteraccionModal.Icono(i.Tipo)" Size="15" /></div>
                                <div class="two-line" style="flex:1;min-width:0">
                                    <span class="t1">@i.Resumen</span>
                                    @if (i.Resultado is { Length: > 0 } res)
                                    {
                                        <span class="t2 interaction-result">@res</span>
                                    }
                                    <span class="t2">@T($"interaccion.tipo.{i.Tipo}")@(vi.Contacto is { Length: > 0 } k ? $" · {k}" : "")@(i.ResponsableNombre is null ? "" : $" · {i.ResponsableNombre}")</span>
                                </div>
                                <span class="when muted">@Fmt.Ago(i.Fecha)</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-head">
                        <div>
                            <h3>@T("customerdetail.actividad_en_la_suite")</h3>
                            <div class="sub">@T("customerdetail.compras_en_caja_comprobantes_pagos")</div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (f.Actividad.Count == 0)
                        {
                            <div class="list-row"><span class="muted">@T("customerdetail.aun_no_hay_actividad_de")</span></div>
                        }
                        <div class="timeline">
                            @foreach (var a in f.Actividad)
                            {
                                <div class="ev" @key="a.Id">
                                    <div class="stat-icon"><Icon Name="@Fmt.Activity(a.Tipo)" Size="16" /></div>
                                    <div class="two-line" style="flex:1">
                                        <span class="t1">@a.Titulo</span>
                                        <span class="t2">@Fmt.DateTime(a.OcurridoEn) · @a.Origen@(a.Detalle is null ? "" : $" · {a.Detalle}")</span>
                                    </div>
                                    @if (a.Monto is { } monto)
                                    {
                                        <strong>@Fmt.Money(monto, a.Moneda ?? "PEN")</strong>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
                <div class="card">
                    <div class="card-head"><h3>@T("customerdetail.datos")</h3></div>
                    <div class="card-body">
                        <dl class="kv">
                            <dt>@T("customerdetail.razon_social")</dt><dd>@c.Name</dd>
                            <dt>@T("customerdetail.telefono")</dt><dd>@(c.Phone ?? "—")</dd>
                            <dt>@T("customerdetail.correo")</dt><dd>@(c.Email ?? "—")</dd>
                            <dt>@T("customerdetail.direccion")</dt><dd>@(c.FullAddress ?? "—")</dd>
                            @if (c.Notes is not null)
                            {
                                <dt>@T("customerdetail.notas")</dt><dd>@c.Notes</dd>
                            }
                        </dl>
                        @if (c.Pending)
                        {
                            <div class="alert info" style="margin-top:12px"><Icon Name="sync" Size="18" /><span>@T("customerdetail.registrado_en_este_equipo_se")</span></div>
                        }
                    </div>
                </div>

                <SegmentacionCliente ClienteId="c.Id" />
                <CamposPersonalizados Entidad="@EntidadesCampo.Cliente" RegistroId="c.Id" />

                <div class="card">
                    <div class="card-head"><h3>@T("customerdetail.contactos")</h3><button class="btn btn-sm" @onclick="NuevoContacto"><Icon Name="plus" Size="16" />@T("customerdetail.nuevo")</button></div>
                    <div class="card-body">
                        @if (f.Contactos.Count == 0)
                        {
                            <div class="list-row"><span class="muted">@T("customerdetail.sin_contactos")</span></div>
                        }
                        @foreach (var k in f.Contactos)
                        {
                            <div class="list-row" style="cursor:pointer" @onclick="() => EditarContacto(k)">
                                <Avatar Text="@k.NombreCompleto" Size="34" />
                                <div class="two-line" style="flex:1"><span class="t1">@k.NombreCompleto</span><span class="t2">@(k.Cargo ?? "")@(k.Telefono is null ? "" : $" · {k.Telefono}")</span></div>
                                @if (TelefonoPeru.ParaWhatsApp(k.Telefono) is not null)
                                {
                                    <button class="btn btn-ghost icon-btn sm" @onclick:stopPropagation @onclick="() => Mensaje(CanalPlantilla.WhatsApp, k.Telefono, k.Id)" title="@(T("customerdetail.whatsapp"))"><Icon Name="message" Size="16" /></button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-head"><h3>@T("customerdetail.tareas")</h3><button class="btn btn-sm" @onclick="NuevaTarea"><Icon Name="plus" Size="16" />@T("customerdetail.nueva")</button></div>
                    <div class="card-body">
                        @if (f.Tareas.Count == 0)
                        {
                            <div class="list-row"><span class="muted">@T("customerdetail.sin_tareas")</span></div>
                        }
                        @foreach (var v in f.Tareas.OrderBy(t => t.Tarea.Completada).ThenBy(t => t.Tarea.Fecha))
                        {
                            var t = v.Tarea;
                            <div class="task @(t.Completada ? "done" : "")">
                                <input type="checkbox" checked="@t.Completada" @onchange="() => AlternarAsync(t)" aria-label="@(T("customerdetail.hecha"))" />
                                <div class="two-line" style="cursor:pointer" @onclick="() => EditarTarea(t)"><span class="t1">@t.Titulo</span><span class="t2">@Fmt.TaskType(t.Tipo)@(t.ResponsableNombre is null ? "" : $" · {t.ResponsableNombre}")</span></div>
                                <span class="when @(t.EstaVencida(Fmt.Today) ? "warn-text" : "muted")">@Fmt.Relative(t.Fecha)@(t.Hora is { } h ? $" {FormatoPeru.Hora(h)}" : "")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (!Loading)
{
    <div class="page"><EmptyState Icon="alert" Title="@(T("customerdetail.cliente_no_encontrado"))" Text="@(T("customerdetail.puede_que_aun_no_haya"))"><a class="btn btn-dark" href="clientes">@T("customerdetail.ver_clientes")</a></EmptyState></div>
}

@if (_oportunidad is { } o)
{
    <OportunidadModal Valor="o" Nueva="_nuevo" OnClose="() => _oportunidad = null" OnSaved="CerradoAsync" />
}
@if (_interaccion is { } ix)
{
    <InteraccionModal Valor="ix" Nueva="_nuevo" Contactos="_ficha?.Contactos ?? []" OnClose="() => _interaccion = null" OnSaved="CerradoAsync" />
}
@if (_completar is { } ct)
{
    <CompletarTareaModal Tarea="ct" OnClose="() => _completar = null" OnDone="CerradoAsync" />
}
@if (_mensaje is { } m && _ficha is { } fm)
{
    <MensajeModal Canal="m.Canal" ClienteId="fm.Cliente.Id" ContactoId="m.ContactoId" Nombre="@fm.Cliente.DisplayName" Telefono="@m.Telefono"
                  Email="@fm.Cliente.Email" OnClose="() => _mensaje = null" OnSent="CerradoAsync" />
}
@if (_tarea is { } t2)
{
    <TareaModal Valor="t2" Nueva="_nuevo" OnClose="() => _tarea = null" OnSaved="CerradoAsync" />
}
@if (_contacto is { } k2)
{
    <ContactoModal Valor="k2" Nuevo="_nuevo" OnClose="() => _contacto = null" OnSaved="CerradoAsync" />
}

@if (_asignar)
{
    <Modal Title="@(T("customerdetail.responsable_del_cliente"))" Subtitle="@_ficha?.Cliente.DisplayName" Size="sm" OnClose="() => _asignar = false">
        <ChildContent>
            <div class="field">
                <label>@T("customerdetail.lo_atiende")</label>
                <select class="select" @bind="_responsable">
                    <option value="">@T("customerdetail.sin_responsable")</option>
                    @foreach (var v in _vendedores)
                    {
                        <option value="@v.Id">@v.Nombre</option>
                    }
                </select>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _asignar = false">@T("customerdetail.cancelar")</button>
            <button class="btn btn-dark" @onclick="() => AsignarAsync(_responsable, _vendedores.FirstOrDefault(v => v.Id == _responsable)?.Nombre)">@T("customerdetail.guardar")</button>
        </Footer>
    </Modal>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private FichaCliente? _ficha;
    private Oportunidad? _oportunidad;
    private Tarea? _tarea;
    private Contacto? _contacto;
    private bool _nuevo, _asignar;
    private IReadOnlyList<Vendedor> _vendedores = [];
    private Guid? _responsable;

    private async Task AbrirAsignar()
    {
        _vendedores = await Crm.Cartera.VendedoresAsync();
        _responsable = _ficha?.Cliente.OwnerId;
        _asignar = true;
    }

    private async Task AsignarAsync(Guid? id, string? nombre)
    {
        _asignar = false;
        await RunAsync(() => Crm.Cartera.AsignarAsync(Id, id, nombre), T("customerdetail.responsable_guardado"));
        await ReloadAsync();
    }

    private IReadOnlyList<InteraccionVista> _interacciones = [];
    private Interaccion? _interaccion;
    private Tarea? _completar;
    private (CanalPlantilla Canal, string? Telefono, Guid? ContactoId)? _mensaje;

    protected override async Task LoadAsync()
    {
        _ficha = await Crm.Clientes.FichaAsync(Id);
        _interacciones = await Crm.Actividades.InteraccionesAsync(Id, limite: 30);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_ficha is not null && _ficha.Cliente.Id != Id)
            await ReloadAsync();
    }

    private void NuevaOportunidad() { _nuevo = true; _oportunidad = new Oportunidad { ClienteId = Id, CreadoEn = DateTimeOffset.UtcNow }; }
    private void EditarOportunidad(Oportunidad o) { _nuevo = false; _oportunidad = o.Clonar(); }
    private void NuevaTarea() { _nuevo = true; _tarea = Crm.Tareas.Nueva(Id); }
    private void EditarTarea(Tarea t) { _nuevo = false; _tarea = t.Clonar(); }
    private void NuevoContacto() { _nuevo = true; _contacto = new Contacto { ClienteId = Id, CreadoEn = DateTimeOffset.UtcNow }; }
    private void EditarContacto(Contacto k) { _nuevo = false; _contacto = k.Clonar(); }

    private async Task CerradoAsync()
    {
        _oportunidad = null;
        _tarea = null;
        _contacto = null;
        _interaccion = null;
        _completar = null;
        _mensaje = null;
        await ReloadAsync();
    }

    /// <summary>Al marcar una tarea pendiente se pide su resultado (queda en la ficha); desmarcarla la reabre.</summary>
    private async Task AlternarAsync(Tarea t)
    {
        if (t.Completada)
            await RunAsync(() => Crm.Tareas.ReabrirAsync(t.Id));
        else
            _completar = t;
    }

    private void NuevaInteraccion() { _nuevo = true; _interaccion = Crm.Actividades.Nueva(Id); }
    private void EditarInteraccion(Interaccion i) { _nuevo = false; _interaccion = i.Clonar(); }
    private void Mensaje(CanalPlantilla canal, string? telefono, Guid? contacto) => _mensaje = (canal, telefono, contacto);
}
