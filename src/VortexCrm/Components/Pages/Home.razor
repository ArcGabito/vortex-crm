@page "/"
@inherits CrmPage

<SectionContent SectionName="page-title">@T("home.panel")</SectionContent>

@if (_panel is { } p)
{
    <div class="stat-strip">
        <StatTile Icon="target" Label="@(T("home.en_curso"))" Value="@Fmt.MoneyCompact(p.Pipeline.MontoEnCurso, "PEN")" Hint="@Fmt.Count(p.Pipeline.CantidadEnCurso, T("count.oportunidad"), T("count.oportunidades"))" />
        <StatTile Icon="star" Label="@(T("home.ganado_este_mes"))" Value="@Fmt.MoneyCompact(p.GanadoEsteMes, "PEN")" Hint="@(p.Pipeline.TasaDeCierre is { } t ? T("home.cierras_el", t) : null)" />
        <StatTile Icon="file" Label="@(T("home.cotizaciones_abiertas"))" Value="@Fmt.Compact(p.CotizacionesAbiertas)" Hint="@Fmt.MoneyCompact(p.MontoCotizado, "PEN")" />
        <StatTile Icon="calendar" Label="@(T("home.para_hoy"))" Value="@Fmt.Compact(p.TareasParaHoy)" Hint="@(p.TareasVencidas > 0 ? T("home.vencidas", p.TareasVencidas) : "nada vencido")" />
    </div>
}

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("home.hola", FirstName)</h2>
            <p>@T("home.asi_van_tus_ventas", (Session.Session?.Access.OrganizationName))</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn btn-outline" href="pipeline?nueva=1"><Icon Name="target" Size="18" />@T("home.nueva_oportunidad")</a>
            <a class="btn btn-dark" href="cotizaciones/nueva"><Icon Name="file" Size="18" />@T("home.nueva_cotizacion")</a>
        </div>
    </div>

    <div class="grid-2">
        <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("home.ventas_ganadas")</h3>
                        <div class="sub">@T("home.oportunidades_ganadas_en_los_ultimos")</div>
                    </div>
                    <a class="btn btn-sm" href="pipeline">@T("home.ver_pipeline")</a>
                </div>
                <div class="card-body">
                    @if (_panel is { } ventas && ventas.VentasPorMes.Any(m => m.Monto > 0))
                    {
                        var max = ventas.VentasPorMes.Max(m => m.Monto);
                        <div class="chart-bars" role="img" aria-label="@(T("home.ventas_ganadas_por_mes"))">
                            @foreach (var m in ventas.VentasPorMes)
                            {
                                <div class="col" title="@($"{Fmt.Amount(m.Monto)} en {Fmt.Count(m.Cantidad, T("count.venta"), T("count.ventas"))}")">
                                    <span class="value">@Fmt.Compact(m.Monto)</span>
                                    <div class="stack" style="height:@(max == 0 ? 0 : (int)(m.Monto / max * 100))%"><span class="pos" style="flex:1"></span></div>
                                    <span class="label">@m.Mes.ToString("MMM", Fmt.Culture)</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyState Icon="star" Title="@(T("home.aun_no_hay_ventas_ganadas"))" Text="@(T("home.cuando_ganes_oportunidades_veras_aqui"))" />
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("home.actividad_de_tus_clientes")</h3>
                        <div class="sub">@T("home.lo_ultimo_que_informaron_el")</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (_actividad.Count == 0)
                    {
                        <div class="list-row"><span class="muted">@T("home.sin_actividad_todavia")</span></div>
                    }
                    <div class="timeline">
                        @foreach (var a in _actividad)
                        {
                            <a class="ev" href="@($"clientes/{a.ClienteId}")" @key="a.Id">
                                <div class="stat-icon"><Icon Name="@Fmt.Activity(a.Tipo)" Size="16" /></div>
                                <div class="two-line" style="flex:1"><span class="t1">@a.Titulo</span><span class="t2">@(_nombres.GetValueOrDefault(a.ClienteId) ?? T("home.cliente")) · @Fmt.Ago(a.OcurridoEn)</span></div>
                                @if (a.Monto is { } monto)
                                {
                                    <strong>@Fmt.Money(monto, a.Moneda ?? "PEN")</strong>
                                }
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <div>
                    <h3>@T("home.para_hoy")</h3>
                    <div class="sub">@T("home.tus_tareas_de_hoy_las")</div>
                </div>
                <a class="btn btn-sm" href="tareas">@T("home.ver_agenda")</a>
            </div>
            <div class="card-body">
                @if (_hoy.Count == 0)
                {
                    <EmptyState Icon="package-check" Title="@(T("home.todo_al_dia"))" Text="@(T("home.no_tienes_tareas_para_hoy"))" />
                }
                @foreach (var v in _hoy)
                {
                    var t = v.Tarea;
                    <div class="task" @key="t.Id">
                        <input type="checkbox" @onchange="() => CompletarAsync(t)" aria-label="@(T("home.hecha"))" />
                        <div class="two-line" style="flex:1"><span class="t1">@t.Titulo</span><span class="t2">@Fmt.TaskType(t.Tipo)@(v.Cliente is null ? "" : $" · {v.Cliente}")</span></div>
                        <span class="when @(t.EstaVencida(Fmt.Today) ? "warn-text" : "muted")">@Fmt.Relative(t.Fecha)@(t.Hora is { } h ? $" · {FormatoPeru.Hora(h)}" : "")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private PanelCrm? _panel;
    private IReadOnlyList<TareaVista> _hoy = [];
    private IReadOnlyList<ActividadRow> _actividad = [];
    private Dictionary<Guid, string> _nombres = [];

    private string FirstName => Session.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    protected override async Task LoadAsync()
    {
        _panel = await Crm.Clientes.PanelAsync();
        var hoy = Fmt.Today;
        _hoy = (await Crm.Tareas.ListarAsync(soloMias: true)).Where(t => !t.Tarea.Completada && t.Tarea.Fecha <= hoy).ToList();
        _actividad = await Crm.Clientes.ActividadAsync(null, 8);
        _nombres = (await Crm.Master.GetPartyOptionsAsync(suppliers: false)).ToDictionary(o => o.Id, o => o.Label);
    }

    private Task CompletarAsync(Tarea t) => RunAsync(() => Crm.Tareas.CompletarAsync(t.Id), T("home.tarea_hecha"));
}
