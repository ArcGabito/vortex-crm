@page "/"
@inherits CrmPage
@inject FileExporter Exporter

<SectionContent SectionName="page-title">@T("home.panel")</SectionContent>

<div class="page dashboard">
    <div class="page-head">
        <div>
            <h2>@((MarkupString)T("home.bienvenido_de_nuevo", System.Net.WebUtility.HtmlEncode(FirstName)))</h2>
            <p>@T("home.este_es_el_resumen")</p>
        </div>
        <div class="head-actions">
            <a class="btn btn-outline" href="pipeline?nueva=1"><Icon Name="target" Size="18" />@T("home.nueva_oportunidad")</a>
            <a class="btn btn-dark" href="cotizaciones/nueva"><Icon Name="file" Size="18" />@T("home.nueva_cotizacion")</a>
        </div>
    </div>

    @if (_tablero is { } t && _panel is { } p)
    {
        <div class="metric-grid">
            <div class="metric dark">
                <div class="metric-top"><span>@T("home.ganado_este_mes")</span><span class="metric-icon"><Icon Name="star" Size="20" /></span></div>
                <div class="metric-value">@Fmt.Amount(t.GanadoEsteMes)</div>
                <Delta Value="t.CambioGanadoPct" />
            </div>
            <div class="metric">
                <div class="metric-top"><span>@T("home.ticket_promedio")</span><span class="metric-icon"><Icon Name="receipt" Size="20" /></span></div>
                <div class="metric-value">@Fmt.Amount(t.TicketPromedio)</div>
                <Delta Value="t.CambioTicketPct" />
            </div>
            <div class="metric">
                <div class="metric-top"><span>@T("home.en_curso")</span><span class="metric-icon"><Icon Name="target" Size="20" /></span></div>
                <div class="metric-value">@Fmt.Amount(p.Pipeline.MontoEnCurso)</div>
                <div class="metric-foot">
                    @Fmt.Count(p.Pipeline.CantidadEnCurso, T("count.oportunidad"), T("count.oportunidades"))@(p.Pipeline.TasaDeCierre is { } tasa ? $" · {T("home.cierras_el", tasa)}" : "")
                </div>
            </div>
        </div>

        <div class="dash-grid">
            <section class="card">
                <div class="card-head">
                    <h3>@T("home.ventas_en_el_tiempo")</h3>
                    <div class="legend-dots">
                        <span><i class="dot a"></i>@T("home.ganado")</span>
                        <span><i class="dot b"></i>@T("home.cotizado")</span>
                        <KebabMenu>
                            <a href="pipeline"><Icon Name="layers" Size="18" />@T("home.ver_pipeline")</a>
                            <a href="cotizaciones"><Icon Name="file" Size="18" />@T("home.ver_cotizaciones")</a>
                        </KebabMenu>
                    </div>
                </div>
                <div class="card-body">
                    @if (t.Tendencia.All(m => m.Ganado + m.Cotizado == 0))
                    {
                        <EmptyState Icon="star" Title="@(T("home.aun_no_hay_ventas_ganadas"))" Text="@(T("home.cuando_ganes_oportunidades_veras_aqui"))" />
                    }
                    else
                    {
                        <LineChart Labels="@(t.Tendencia.Select(m => m.Mes.ToString("MMM", Fmt.Culture)).ToList())"
                                   A="@(t.Tendencia.Select(m => m.Ganado).ToList())" B="@(t.Tendencia.Select(m => m.Cotizado).ToList())"
                                   LabelA="@(T("home.ganado"))" LabelB="@(T("home.cotizado"))" Format="Fmt.Amount"
                                   AriaLabel="@(T("home.ventas_en_el_tiempo"))" />
                    }
                </div>
            </section>

            <section class="card">
                <div class="card-head">
                    <div class="segmented sm">
                        <button class="@(_side == Side.Deals ? "on" : "")" @onclick="() => _side = Side.Deals">@T("home.oportunidades_principales")</button>
                        <button class="@(_side == Side.Today ? "on" : "")" @onclick="() => _side = Side.Today">
                            @T("home.para_hoy")@(_hoy.Count > 0 ? $" · {_hoy.Count}" : "")
                        </button>
                    </div>
                    <a class="btn btn-sm" href="@(_side == Side.Deals ? "pipeline" : "tareas")">@T("home.ver_todo")</a>
                </div>
                <div class="card-body">
                    @if (_side == Side.Deals)
                    {
                        if (_principales.Count == 0)
                        {
                            <EmptyState Icon="target" Title="@(T("home.sin_oportunidades_abiertas"))" Text="@(T("home.crea_una_oportunidad"))" />
                        }
                        foreach (var v in _principales)
                        {
                            var o = v.Oportunidad;
                            var (text, tone) = StatusPill.ForEtapa(o.Etapa);
                            <a class="top-item" href="pipeline" @key="o.Id">
                                <Avatar Text="@(v.Cliente ?? o.Titulo)" Size="44" Class="square" />
                                <div class="two-line">
                                    <span class="t1">@o.Titulo</span>
                                    <span class="t2">@(v.Cliente ?? T("home.sin_cliente"))</span>
                                </div>
                                <div class="two-line end">
                                    <span class="pill @tone plain">@text</span>
                                    <span class="t2">@Fmt.Amount(o.Monto)@(o.FechaCierreEstimada is { } cierre ? $" · {Fmt.Date(cierre)}" : "")</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        if (_hoy.Count == 0)
                        {
                            <EmptyState Icon="package-check" Title="@(T("home.todo_al_dia"))" Text="@(T("home.no_tienes_tareas_para_hoy"))" />
                        }
                        foreach (var v in _hoy)
                        {
                            var tarea = v.Tarea;
                            <div class="task" @key="tarea.Id">
                                <input type="checkbox" @onchange="() => CompletarAsync(tarea)" aria-label="@(T("home.hecha"))" />
                                <div class="two-line" style="flex:1"><span class="t1">@tarea.Titulo</span><span class="t2">@Fmt.TaskType(tarea.Tipo)@(v.Cliente is null ? "" : $" · {v.Cliente}")</span></div>
                                <span class="when @(tarea.EstaVencida(Fmt.Today) ? "warn-text" : "muted")">@Fmt.Relative(tarea.Fecha)@(tarea.Hora is { } h ? $" · {FormatoPeru.Hora(h)}" : "")</span>
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    }

    <section class="card">
        <div class="card-head">
            <h3>@T("home.ultimas_cotizaciones")</h3>
            <div class="head-actions">
                <div class="menu-anchor">
                    <button class="btn btn-sm @(_estado is null ? "" : "on")" @onclick="() => _filterOpen = !_filterOpen">
                        <Icon Name="list" Size="16" />@(_estado is { } e ? StatusPill.ForEstado(e).Text : T("home.filtrar"))
                    </button>
                    @if (_filterOpen)
                    {
                        <div class="menu-backdrop" @onclick="() => _filterOpen = false"></div>
                        <div class="menu" @onclick="() => _filterOpen = false">
                            <button @onclick="() => _estado = null">@T("home.todas")</button>
                            @foreach (var estado in EstadosCotizacion.Todos)
                            {
                                <button @onclick="() => _estado = estado">@StatusPill.ForEstado(estado).Text</button>
                            }
                        </div>
                    }
                </div>
                <button class="btn btn-sm" disabled="@(Filtradas.Count == 0)" @onclick="ExportAsync"><Icon Name="download" Size="16" />@T("home.exportar")</button>
            </div>
        </div>
        @if (Filtradas.Count == 0)
        {
            <div class="card-body"><EmptyState Icon="file" Title="@(T("home.sin_cotizaciones"))" Text="@(T("home.las_cotizaciones_apareceran_aqui"))" /></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@T("home.cotizacion")</th>
                            <th>@T("home.cliente")</th>
                            <th>@T("home.emitida")</th>
                            <th>@T("home.valida_hasta")</th>
                            <th class="num">@T("home.total")</th>
                            <th>@T("home.estado")</th>
                            <th class="actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Filtradas.Take(8))
                        {
                            var (text, tone) = StatusPill.ForCotizacion(q, Fmt.Today);
                            <tr @key="q.Id">
                                <td class="strong">@q.Codigo</td>
                                <td>@(q.Cliente ?? "—")</td>
                                <td class="muted">@Fmt.Date(q.FechaEmision)</td>
                                <td><span class="@(q.Vencida(Fmt.Today) ? "warn-text" : "muted")">@Fmt.Date(q.ValidaHasta)</span></td>
                                <td class="num strong">@Fmt.Money(q.Total, q.Moneda)</td>
                                <td><span class="status-text @tone">@text</span></td>
                                <td class="actions-col">
                                    <KebabMenu>
                                        <a href="@($"cotizaciones/{q.Id}")"><Icon Name="eye" Size="18" />@T("home.abrir")</a>
                                        @if (q.ClienteId is { } cliente)
                                        {
                                            <a href="@($"clientes/{cliente}")"><Icon Name="briefcase" Size="18" />@T("home.ver_cliente")</a>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private enum Side { Deals, Today }

    private PanelCrm? _panel;
    private TableroVentas? _tablero;
    private IReadOnlyList<OportunidadVista> _principales = [];
    private IReadOnlyList<TareaVista> _hoy = [];
    private IReadOnlyList<CotizacionVista> _cotizaciones = [];
    private EstadoCotizacion? _estado;
    private Side _side = Side.Deals;
    private bool _filterOpen;

    private string FirstName => Session.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    private IReadOnlyList<CotizacionVista> Filtradas =>
        _estado is { } e ? _cotizaciones.Where(q => q.Estado == e).ToList() : _cotizaciones;

    protected override async Task LoadAsync()
    {
        _panel = await Crm.Clientes.PanelAsync();
        (_tablero, _principales) = await Crm.Clientes.TableroAsync();
        var hoy = Fmt.Today;
        _hoy = (await Crm.Tareas.ListarAsync(soloMias: true)).Where(t => !t.Tarea.Completada && t.Tarea.Fecha <= hoy).ToList();
        _cotizaciones = (await Crm.Cotizaciones.ListarAsync()).OrderByDescending(q => q.CreadoEn).ToList();
    }

    private Task CompletarAsync(Tarea t) => RunAsync(() => Crm.Tareas.CompletarAsync(t.Id), T("home.tarea_hecha"));

    /// <summary>Las cotizaciones del filtro en CSV (separador ; y decimales con punto).</summary>
    private async Task ExportAsync()
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var csv = new System.Text.StringBuilder();
        csv.AppendLine(string.Join(';', T("home.cotizacion"), T("home.cliente"), T("home.emitida"), T("home.valida_hasta"), T("home.moneda"),
            T("home.total"), T("home.estado")));
        foreach (var q in Filtradas)
            csv.AppendLine(string.Join(';', q.Codigo, Csv(q.Cliente), q.FechaEmision.ToString("yyyy-MM-dd", inv), q.ValidaHasta.ToString("yyyy-MM-dd", inv),
                q.Moneda, q.Total.ToString(inv), StatusPill.ForCotizacion(q, Fmt.Today).Text));
        try
        {
            var bytes = new System.Text.UTF8Encoding(true).GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
            var path = await Exporter.ExportBytesAsync($"vortex-crm-cotizaciones-{Fmt.Today:yyyyMMdd}.csv", bytes, "text/csv");
            Toasts.Success(T("home.exportado", Path.GetFileName(path)));
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private static string Csv(string? value) =>
        value is null ? "" : value.Contains(';') || value.Contains('"') ? $"\"{value.Replace("\"", "\"\"")}\"" : value;
}
