@page "/configuracion"
@inherits CrmPage
@using VortexApi.Client.Sync
@using VortexCrm.Core.Domain.Segmentos

<SectionContent SectionName="page-title">@T("settings.configuracion")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("settings.configuracion")</h2>
            <p>@T("settings.tu_cuenta_la_conexion_con")</p>
        </div>
    </div>

    <div class="grid-2">
        <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.ventas")</h3>
                        <div class="sub">@T("settings.valen_para_toda_la_organizacion")</div>
                    </div>
                    <button class="btn btn-dark btn-sm" disabled="@(_busy || !Session.Can(CrmPermissions.EditSettings))" @onclick="GuardarAjustesAsync">@T("settings.guardar")</button>
                </div>
                <div class="card-body" style="display:flex;flex-direction:column;gap:14px">
                    <div class="field">
                        <label>@T("settings.igv_de_las_cotizaciones_nuevas")</label>
                        <select class="select" @bind="_modoIgv">
                            @foreach (var m in Enum.GetValues<ModoIgv>())
                            {
                                <option value="@m">@Fmt.TaxMode(m)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>@T("settings.condiciones_que_se_copian_en")</label>
                        <textarea class="control" rows="3" placeholder="@(T("settings.forma_de_pago_tiempo_de"))" @bind="_condiciones"></textarea>
                    </div>
                    <div class="field">
                        <label>@T("settings.descuento_maximo")</label>
                        <input class="control" type="number" inputmode="decimal" min="0" max="100" step="0.5" placeholder="@(T("settings.sin_tope"))" @bind="_descuentoMaximo" />
                        <span class="hint">@T("settings.descuento_maximo_explica")</span>
                    </div>
                    <div class="field">
                        <label>@T("settings.motivos_de_perdida")</label>
                        <textarea class="control" rows="5" placeholder="@(T("settings.un_motivo_por_linea"))" @bind="_motivos"></textarea>
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <a class="btn btn-sm" href="embudos"><Icon Name="layers" Size="16" />@T("settings.embudos_de_venta")</a>
                        <a class="btn btn-sm" href="automatizacion"><Icon Name="play" Size="16" />@T("automatizacion.titulo")</a>
                    </div>
                    @if (Recordatorios.Disponible)
                    {
                        <button class="btn btn-sm" style="align-self:flex-start" @onclick="PermisoAsync"><Icon Name="bell" Size="16" />@T("settings.permitir_avisos_de_tareas")</button>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.sincronizacion")</h3>
                        <div class="sub">@T("settings.todo_se_guarda_primero_en")</div>
                    </div>
                    <button class="btn btn-dark btn-sm" disabled="@Session.Sync.IsSyncing" @onclick="Session.SyncNow"><Icon Name="sync" Size="16" />@T("settings.sincronizar_ahora")</button>
                </div>
                <div class="card-body">
                    <div class="list-row">
                        <span>@T("settings.estado")</span>
                        <span class="end"><span class="pill @ConnectionTone">@ConnectionText</span></span>
                    </div>
                    <div class="list-row">
                        <span>@T("settings.ultima_sincronizacion")</span>
                        <span class="end strong" style="font-weight:600">@(Session.Sync.LastSyncAt is { } at ? Fmt.DateTime(at) : T("settings.aun_no"))</span>
                    </div>
                    <div class="list-row">
                        <span>@T("settings.operaciones_por_subir")</span>
                        <strong class="end">@Session.Sync.Pending</strong>
                    </div>
                    @if (Session.Sync.LastResult is { } r)
                    {
                        <div class="list-row">
                            <span>@T("settings.ultima_vuelta")</span>
                            <span class="end muted">@(Fmt.Count(r.PushedEvents + r.PushedMasterWrites, T("settings.envio"), T("settings.envios"))) · @(Fmt.Count(r.PulledChanges + r.PulledEvents, T("count.recibido"), T("count.recibidos")))</span>
                        </div>
                    }
                    @if (Session.Connection == ConnectionState.Offline && Session.OfflineValidUntil is { } until)
                    {
                        <div class="alert warn" style="margin-top:12px"><Icon Name="wifi-off" Size="18" /><span>@T("settings.sin_conexion_puedes_seguir_trabajando", Fmt.DateTime(until))</span></div>
                    }
                    @if (Session.Sync.LastError is { } error)
                    {
                        <div class="alert error" style="margin-top:12px"><Icon Name="alert" Size="18" /><span>@error</span></div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.rechazadas_por_el_hub")</h3>
                        <div class="sub">@T("settings.operaciones_que_el_hub_no")</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (_failed.Count == 0)
                    {
                        <div class="list-row"><Icon Name="check" Size="18" Class="faint" /><span class="muted">@T("settings.no_hay_operaciones_rechazadas")</span></div>
                    }
                    @foreach (var f in _failed)
                    {
                        <div class="list-row" @key="f.Entry.Id" style="align-items:flex-start">
                            <div class="two-line" style="flex:1">
                                <span class="t1">@Describe(f.Entry)</span>
                                <span class="t2" style="white-space:normal">@HubErrors.ForFailed(f.ErrorCode, f.Error)</span>
                                <span class="t2">@Fmt.DateTime(f.FailedAt)</span>
                            </div>
                            <button class="btn btn-sm" @onclick="() => DismissAsync(f)">@T("settings.descartar")</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
            <div class="card">
                <div class="card-head"><h3>@T("settings.cuenta")</h3></div>
                <div class="card-body">
                    @if (Session.Session is { } s)
                    {
                        <div class="list-row">
                            <Avatar Text="@s.User.FullName" Size="44" Class="user" />
                            <div class="two-line">
                                <span class="t1">@s.User.FullName</span>
                                <span class="t2">@s.User.Email</span>
                            </div>
                        </div>
                        <dl class="kv" style="margin:12px 0 16px">
                            <dt>@T("settings.organizacion")</dt>
                            <dd>@s.Access.OrganizationName</dd>
                            <dt>@T("settings.rol_en_el_crm")</dt>
                            <dd>@RoleLabel(Session.Role)<div class="muted" style="font-weight:500">@T("settings.lo_asigna_el_administrador_de")</div></dd>
                        </dl>
                    }
                    <button class="btn btn-danger btn-sm" @onclick="() => Session.SignOutAsync()"><Icon Name="logout" Size="16" />@T("settings.cerrar_sesion")</button>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><h3>@T("settings.este_equipo")</h3></div>
                <div class="card-body">
                    <div class="field" style="margin-bottom:14px">
                        <label>@T("settings.language")</label>
                        <select class="select" value="@(Session.LanguagePreference ?? "")" @onchange="e => Session.SetLanguageAsync(e.Value?.ToString())">
                            <option value="">@T("settings.idioma_del_pais")</option>
                            @foreach (var language in VortexApi.Suite.Regional.Languages.Supported)
                            {
                                <option value="@language">@VortexApi.Suite.Regional.Languages.NameOf(language)</option>
                            }
                        </select>
                    </div>
                    <div class="field" style="margin-bottom:14px">
                        <label>@T("settings.sede_que_emite_las_cotizaciones")</label>
                        <select class="select" value="@Session.DefaultSiteId" @onchange="e => Session.SetDefaultSite(Guid.TryParse(e.Value?.ToString(), out var g) ? g : null)">
                            <option value="">@T("settings.domicilio_fiscal")</option>
                            @foreach (var site in _sites)
                            {
                                <option value="@site.Id">@site.Name</option>
                            }
                        </select>
                    </div>
                    <dl class="kv">
                        <dt>@T("settings.servidor_del_hub")</dt>
                        <dd>@Session.HubUrl</dd>
                        <dt>@T("settings.prefijo_de_documentos")</dt>
                        <dd>@Session.DeviceTag<div class="muted" style="font-weight:500">@T("settings.ej_cot_0001", Session.DeviceTag)</div></dd>
                        <dt>@T("settings.id_del_equipo")</dt>
                        <dd>@Session.DeviceId</dd>
                        @if (Session.Session is { } s2)
                        {
                            <dt>@T("settings.acceso_sin_conexion")</dt>
                            <dd>@T("settings.hasta_el", Fmt.DateTime(s2.OfflineTokenExpiresAt))</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.plantillas")</h3>
                        <div class="sub">@T("settings.plantillas_explica")</div>
                    </div>
                    @if (Session.Can(CrmPermissions.EditSettings))
                    {
                        <button class="btn btn-sm" @onclick="() => _plantilla = new Plantilla()"><Icon Name="plus" Size="16" />@T("settings.nueva")</button>
                    }
                </div>
                <div class="card-body">
                    @if (_plantillas.Count == 0)
                    {
                        <div class="list-row"><span class="muted">@T("settings.sin_plantillas")</span></div>
                    }
                    @foreach (var p in _plantillas)
                    {
                        <div class="list-row" @key="p.Id" style="@(Session.Can(CrmPermissions.EditSettings) ? "cursor:pointer" : null)"
                             @onclick="() => { if (Session.Can(CrmPermissions.EditSettings)) _plantilla = p.Clonar(); }">
                            <Icon Name="@(p.Canal == CanalPlantilla.WhatsApp ? "message" : "mail")" Size="16" />
                            <div class="two-line" style="flex:1;min-width:0"><span class="t1">@p.Nombre</span><span class="t2 interaction-result">@p.Cuerpo</span></div>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("settings.campos")</h3>
                        <div class="sub">@T("settings.campos_explica")</div>
                    </div>
                    @if (Session.Can(CrmPermissions.EditSettings))
                    {
                        <button class="btn btn-sm" @onclick="() => _campo = new CampoEditor()"><Icon Name="plus" Size="16" />@T("settings.nuevo_campo")</button>
                    }
                </div>
                <div class="card-body">
                    @if (_campos.Count == 0)
                    {
                        <div class="list-row"><span class="muted">@T("settings.sin_campos")</span></div>
                    }
                    @foreach (var campoFila in _campos)
                    {
                        <div class="list-row" @key="campoFila.Id" style="@(Session.Can(CrmPermissions.EditSettings) ? "cursor:pointer" : null)"
                             @onclick="() => { if (Session.Can(CrmPermissions.EditSettings)) _campo = CampoEditor.De(campoFila); }">
                            <div class="two-line" style="flex:1;min-width:0">
                                <span class="t1">@campoFila.Nombre@(campoFila.Obligatorio ? " *" : "")</span>
                                <span class="t2">@T("settings.entidad." + campoFila.Entidad) · @T("settings.tipo." + campoFila.Tipo)@(campoFila.Opciones is { Count: > 0 } ops ? $" · {string.Join(", ", ops)}" : "")</span>
                            </div>
                            @if (!campoFila.Activo)
                            {
                                <span class="tag">@T("settings.inactivo")</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head"><h3>@T("settings.acerca_de")</h3></div>
                <div class="card-body">
                    <div class="list-row">
                        <Logo Size="30" />
                        <span class="end muted">@T("settings.version", Version)</span>
                    </div>
                    <p class="muted" style="font-size:13px;line-height:1.6;margin:10px 0 14px">
                        @T("settings.vortex_crm_es_software_libre")
                        <strong>@T("settings.gnu_agpl_3_0")</strong>@T("settings.si_lo_ofreces_como_servicio")
                        @T("settings.tipografia_montserrat_bajo_la_sil")
                    </p>
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <button class="btn btn-sm" @onclick="() => OpenAsync(SourceUrl)"><Icon Name="external" Size="16" />@T("settings.codigo_fuente")</button>
                        <button class="btn btn-sm" @onclick="() => OpenAsync(IssuesUrl)"><Icon Name="heart" Size="16" />@T("settings.reportar_sugerir")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (_plantilla is { } pl)
{
    <Modal Title="@(pl.Nombre.Length == 0 ? T("settings.nueva_plantilla") : pl.Nombre)" Error="@_errorPlantilla" OnClose="() => _plantilla = null">
        <ChildContent>
            <div class="field">
                <label>@T("settings.nombre")</label>
                <input class="control" placeholder="@(T("settings.plantilla_nombre_ej"))" @bind="pl.Nombre" />
            </div>
            <div class="segmented">
                <button class="@(pl.Canal == CanalPlantilla.WhatsApp ? "on" : "")" @onclick="() => pl.Canal = CanalPlantilla.WhatsApp"><Icon Name="message" Size="15" />WhatsApp</button>
                <button class="@(pl.Canal == CanalPlantilla.Correo ? "on" : "")" @onclick="() => pl.Canal = CanalPlantilla.Correo"><Icon Name="mail" Size="15" />@T("settings.correo")</button>
            </div>
            @if (pl.Canal == CanalPlantilla.Correo)
            {
                <div class="field">
                    <label>@T("settings.asunto")</label>
                    <input class="control" @bind="pl.Asunto" />
                </div>
            }
            <div class="field">
                <label>@T("settings.texto")</label>
                <textarea class="control" rows="6" @bind="pl.Cuerpo" @bind:event="oninput"></textarea>
                <div class="chips">
                    @foreach (var v in Plantillas.Variables)
                    {
                        <button class="chip" @onclick="() => pl.Cuerpo += Variable(v)">@Variable(v)</button>
                    }
                </div>
                <span class="hint">@T("settings.variables_explica")</span>
            </div>
        </ChildContent>
        <Footer>
            @if (_plantillas.Any(x => x.Id == pl.Id))
            {
                <button class="btn btn-ghost danger-text" @onclick="EliminarPlantillaAsync"><Icon Name="trash" Size="16" />@T("settings.eliminar")</button>
            }
            <button class="btn" @onclick="() => _plantilla = null">@T("settings.cancelar")</button>
            <button class="btn btn-dark" @onclick="GuardarPlantillaAsync">@T("settings.guardar")</button>
        </Footer>
    </Modal>
}

@if (_campo is { } ce)
{
    <Modal Title="@(ce.Id == Guid.Empty ? T("settings.nuevo_campo") : ce.Nombre)" Size="sm" Error="@_errorCampo" OnClose="() => _campo = null">
        <ChildContent>
            <div class="field">
                <label>@T("settings.nombre")</label>
                <input class="control" maxlength="60" placeholder="@(T("settings.campo_nombre_ej"))" @bind="ce.Nombre" />
            </div>
            <div class="field">
                <label>@T("settings.campo_aplica_a")</label>
                <select class="select" @bind="ce.Entidad" disabled="@(ce.Id != Guid.Empty)">
                    @foreach (var entidad in EntidadesCampo.Todas)
                    {
                        <option value="@entidad">@T("settings.entidad." + entidad)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>@T("settings.campo_tipo")</label>
                <select class="select" @bind="ce.Tipo">
                    @foreach (var tipo in TiposCampo.Todos)
                    {
                        <option value="@tipo">@T("settings.tipo." + tipo)</option>
                    }
                </select>
            </div>
            @if (ce.Tipo == TiposCampo.Lista)
            {
                <div class="field">
                    <label>@T("settings.campo_opciones")</label>
                    <textarea class="control" rows="4" @bind="ce.Opciones"></textarea>
                    <span class="hint">@T("settings.una_por_linea")</span>
                </div>
            }
            <label class="check"><input type="checkbox" @bind="ce.Obligatorio" />@T("settings.campo_obligatorio")</label>
            <label class="check"><input type="checkbox" @bind="ce.Activo" />@T("settings.campo_activo")</label>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _campo = null">@T("settings.cancelar")</button>
            <button class="btn btn-dark" @onclick="GuardarCampoAsync">@T("settings.guardar")</button>
        </Footer>
    </Modal>
}

@code {
    private const string SourceUrl = "https://github.com/ArcGabito/vortex-crm";
    private const string IssuesUrl = SourceUrl + "/issues";
    private static readonly string Version = AppInfo.Current.Version.ToString(3);

    private IReadOnlyList<VortexFailedEntry> _failed = [];
    private IReadOnlyList<SiteRow> _sites = [];

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    [Inject] private IServicioRecordatorios Recordatorios { get; set; } = null!;

    private IReadOnlyList<Plantilla> _plantillas = [];

    /// <summary>Edición de un campo personalizado (fase 5c): las opciones van una por línea.</summary>
    private sealed class CampoEditor
    {
        public Guid Id { get; set; }
        public string Entidad { get; set; } = EntidadesCampo.Cliente;
        public string Nombre { get; set; } = "";
        public string Tipo { get; set; } = TiposCampo.Texto;
        public string? Opciones { get; set; }
        public bool Obligatorio { get; set; }
        public bool Activo { get; set; } = true;
        public int Orden { get; set; }

        public static CampoEditor De(CampoPersonalizado c) => new()
        {
            Id = c.Id, Entidad = c.Entidad, Nombre = c.Nombre, Tipo = c.Tipo, Opciones = c.Opciones is null ? null : string.Join("\n", c.Opciones),
            Obligatorio = c.Obligatorio, Activo = c.Activo, Orden = c.Orden,
        };

        public CampoPersonalizado Campo() => new(Id, Entidad, Nombre, Tipo,
            Opciones?.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), Obligatorio, Orden, Activo);
    }

    private IReadOnlyList<CampoPersonalizado> _campos = [];
    private CampoEditor? _campo;
    private string? _errorCampo;

    private async Task GuardarCampoAsync()
    {
        if (_campo is not { } ce)
            return;
        _errorCampo = await TryAsync(() => Crm.Segmentos.GuardarCampoAsync(ce.Campo()), T("settings.campo_guardado"));
        if (_errorCampo is null)
        {
            _campo = null;
            _campos = await Crm.Segmentos.CamposAsync(incluirInactivos: true);
        }
    }
    private Plantilla? _plantilla;
    private string? _errorPlantilla;

    private static string Variable(string nombre) => "{" + nombre + "}";

    private async Task CargarPlantillasAsync()
    {
        if (Session.Workspace is { } crm)
            _plantillas = await crm.Actividades.PlantillasAsync();
    }

    private async Task GuardarPlantillaAsync()
    {
        if (_plantilla is not { } pl)
            return;
        _errorPlantilla = await TryAsync(() => Crm.Actividades.GuardarPlantillaAsync(pl), T("settings.plantilla_guardada"));
        if (_errorPlantilla is null)
        {
            _plantilla = null;
            await CargarPlantillasAsync();
        _campos = await Crm.Segmentos.CamposAsync(incluirInactivos: true);
        }
    }

    private async Task EliminarPlantillaAsync()
    {
        if (_plantilla is not { } pl)
            return;
        _errorPlantilla = await TryAsync(() => Crm.Actividades.EliminarPlantillaAsync(pl.Id));
        if (_errorPlantilla is null)
        {
            _plantilla = null;
            await CargarPlantillasAsync();
        }
    }

    private ModoIgv _modoIgv;
    private string? _condiciones, _motivos;
    private decimal? _descuentoMaximo;
    private bool _busy, _ajustesCargados;

    private async Task GuardarAjustesAsync()
    {
        _busy = true;
        await RunAsync(() => Crm.Clientes.GuardarAjustesAsync(new Ajustes(_modoIgv, _condiciones,
            (_motivos ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), _descuentoMaximo)),
            T("settings.ajustes_de_ventas_guardados"));
        _busy = false;
    }

    private async Task PermisoAsync()
    {
        if (await Recordatorios.SolicitarPermisoAsync())
        {
            await Crm.Tareas.ReprogramarAvisosAsync();
            Toasts.Success(T("settings.listo_los_avisos_de_tus"));
        }
        else
        {
            Toasts.Error(T("settings.sin_permiso_para_notificaciones_activalo"));
        }
    }

    protected override async Task LoadAsync()
    {
        if (!_ajustesCargados)
        {
            var ajustes = await Crm.Clientes.ObtenerAjustesAsync();
            (_modoIgv, _condiciones, _descuentoMaximo, _ajustesCargados) = (ajustes.ModoIgvPredeterminado, ajustes.CondicionesPredeterminadas,
                ajustes.DescuentoMaximo, true);
            _motivos = string.Join("\n", ajustes.Motivos);
        }
        _sites = await Crm.Master.GetSitesAsync(activeOnly: true);
        _failed = await Session.GetFailedAsync();
        await CargarPlantillasAsync();
    }

    private void OnSessionChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    private string ConnectionText => Session.Connection switch
    {
        ConnectionState.Online => T("settings.en_linea"),
        ConnectionState.Offline => T("settings.sin_conexion"),
        ConnectionState.OfflineExpired => T("settings.periodo_sin_conexion_agotado"),
        _ => T("settings.conectando"),
    };

    private string ConnectionTone => Session.Connection switch
    {
        ConnectionState.Online => "good",
        ConnectionState.Offline => "warn",
        ConnectionState.OfflineExpired => "bad",
        _ => "neutral",
    };

    // Roles del hub (UserRole) y los que un administrador asigne al acceso del CRM, que se muestran tal cual.
    private static string RoleLabel(string? role) => role switch
    {
        "User" => T("settings.usuario"),
        "OrgAdmin" => T("settings.administrador_de_la_organizacion"),
        "PlatformAdmin" => T("settings.administrador_de_la_plataforma"),
        "administrador" => T("settings.administrador"),
        "gerente_ventas" => T("settings.gerente_de_ventas"),
        "vendedor" => T("settings.vendedor"),
        "consulta" => T("settings.solo_consulta"),
        null or "" => "—",
        _ => role,
    };

    private static string Describe(VortexOutboxEntry e) => e.Kind == VortexOutboxKind.Event
        ? $"Evento {e.EventType}{(e.SubjectId is null ? "" : $" · {e.SubjectId}")}"
        : $"{e.Resource switch { "items" => T("settings.articulo"), "sites" => T("settings.sede"), "parties" => T("settings.cliente_proveedor"), var other => other }} "
          + (e.ExpectedVersion is null ? "nuevo" : "editado");

    private async Task DismissAsync(VortexFailedEntry entry)
    {
        await Session.DismissFailedAsync(entry.Entry.Id);
        Toasts.Info(T("settings.operacion_descartada_si_era_un"));
    }

    private static async Task OpenAsync(string url) => await Launcher.Default.OpenAsync(new Uri(url));

    public override void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        base.Dispose();
    }
}
