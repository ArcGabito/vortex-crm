@page "/cotizaciones"
@inherits CrmPage

<SectionContent SectionName="page-title">@T("quotes.cotizaciones")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("quotes.cotizaciones")</h2>
            <p>@T("quotes.con_igv_en_pdf_por")</p>
        </div>
        <a class="btn btn-dark" href="cotizaciones/nueva"><Icon Name="plus" Size="18" />@T("quotes.nueva_cotizacion")</a>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("quotes.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("quotes.numero_cliente_ruc"))" value="@_busqueda" @oninput="BuscarAsync" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>@T("quotes.estado")</label>
            <div class="segmented">
                <button class="@(_estado is null && !_porAprobar ? "on" : "")" @onclick="async () => { (_estado, _porAprobar) = (null, false); await ReloadAsync(); }">@T("quotes.todas")</button>
                @if (Session.Can(CrmPermissions.ApproveDiscounts))
                {
                    <button class="@(_porAprobar ? "on" : "")" @onclick="async () => { (_estado, _porAprobar) = (null, true); await ReloadAsync(); }">@T("quotes.por_aprobar")</button>
                }
                @foreach (var e in EstadosCotizacion.Todos)
                {
                    <button class="@(_estado == e ? "on" : "")" @onclick="async () => { (_estado, _porAprobar) = (e, false); await ReloadAsync(); }">@StatusPill.ForEstado(e).Text</button>
                }
            </div>
        </div>
    </div>

    @if (_cotizaciones.Count == 0 && !Loading)
    {
        <EmptyState Icon="file" Title="@(T("quotes.no_hay_cotizaciones"))" Text="@(T("quotes.crea_una_desde_aqui_desde"))" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>@T("quotes.cotizacion")</th><th>@T("quotes.cliente")</th><th>@T("quotes.valida_hasta")</th><th class="num">@T("quotes.total")</th><th>@T("quotes.estado")</th></tr></thead>
                <tbody>
                    @foreach (var q in _cotizaciones)
                    {
                        var (text, tone) = StatusPill.ForCotizacion(q, Fmt.Today);
                        <tr @key="q.Id" style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"cotizaciones/{q.Id}"))">
                            <td><div class="two-line"><span class="t1">@q.Codigo</span><span class="t2">@Fmt.Date(q.FechaEmision)</span></div></td>
                            <td><span style="font-weight:600">@(q.Cliente ?? "—")</span></td>
                            <td><span class="@(q.Vencida(Fmt.Today) ? "warn-text" : "muted")">@Fmt.Date(q.ValidaHasta)</span></td>
                            <td class="num strong">@Fmt.Money(q.Total, q.Moneda)</td>
                            <td><StatusPill Text="@text" Tone="@tone" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<CotizacionVista> _cotizaciones = [];
    private EstadoCotizacion? _estado;
    private bool _porAprobar;
    private string _busqueda = "";
    private CancellationTokenSource? _debounce;

    protected override async Task LoadAsync()
    {
        var todas = await Crm.Cotizaciones.ListarAsync(_busqueda, _estado);
        _cotizaciones = _porAprobar ? todas.Where(q => q.PorAprobar).ToList() : todas;
    }

    private async Task BuscarAsync(ChangeEventArgs e)
    {
        _busqueda = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
