@* Marca: dos globos de conversación (el de adelante morado) + "vortexcrm". *@
<div class="logo @(OnDark ? "on-dark" : "")">
    <svg width="@Size" height="@Size" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M20 6 H38 a6 6 0 0 1 6 6 V22 a6 6 0 0 1 -6 6 H36 L36 34 L29 28 H20 a6 6 0 0 1 -6 -6 V12 a6 6 0 0 1 6 -6 Z" fill="@(OnDark ? "#FFFFFF" : "#1C120D")" />
        <path d="M10 17 H28 a6 6 0 0 1 6 6 V33 a6 6 0 0 1 -6 6 H19 L12 45 L12 39 H10 a6 6 0 0 1 -6 -6 V23 a6 6 0 0 1 6 -6 Z" fill="#512BD4" stroke="@(OnDark ? "#1C120D" : "#FFFFFF")" stroke-width="2" />
        <circle cx="12" cy="28" r="2" fill="#FFFFFF" /><circle cx="19" cy="28" r="2" fill="#FFFFFF" /><circle cx="26" cy="28" r="2" fill="#FFFFFF" />
    </svg>
    @if (!IconOnly)
    {
        <span class="word">vortex<b>crm</b></span>
    }
</div>

@code {
    [Parameter] public int Size { get; set; } = 34;
    [Parameter] public bool OnDark { get; set; }
    [Parameter] public bool IconOnly { get; set; }
}
