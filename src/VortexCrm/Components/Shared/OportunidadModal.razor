@inject AppSession Session
@using VortexCrm.Core.Domain.Segmentos
@* Alta y edición de una oportunidad del pipeline: embudo, etapa de ese embudo, cierre, competidor y motivo si se perdió. *@
<Modal Title="@(Nueva ? T("oportunidadmodal.nueva_oportunidad") : T("oportunidadmodal.editar_oportunidad"))" Subtitle="@(T("oportunidadmodal.se_comparte_con_los_demas"))" Error="@_error" OnClose="OnClose">
    <ChildContent>
        <div class="field">
            <label>@T("oportunidadmodal.titulo")</label>
            <input class="control" placeholder="@(T("oportunidadmodal.uniformes_para_2027"))" @bind="Valor.Titulo" />
        </div>
        <div class="form-row">
            <div class="field">
                <label>@T("oportunidadmodal.cliente")</label>
                <select class="select" value="@Valor.ClienteId" @onchange="ElegirClienteAsync">
                    <option value="">@T("oportunidadmodal.elige_un_cliente")</option>
                    @foreach (var c in _clientes)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>@T("oportunidadmodal.contacto_opcional")</label>
                <select class="select" @bind="Valor.ContactoId">
                    <option value="">@T("oportunidadmodal.sin_contacto")</option>
                    @foreach (var c in _contactos)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </div>
        </div>
        @if (_embudos.Count > 1)
        {
            <div class="field">
                <label>@T("oportunidadmodal.embudo")</label>
                <select class="select" value="@(_embudo.Id)" @onchange="ElegirEmbudo">
                    @foreach (var e in _embudos)
                    {
                        <option value="@e.Id">@e.Nombre</option>
                    }
                </select>
            </div>
        }
        <div class="field">
            <label>@T("oportunidadmodal.productos_opcional")</label>
            <ItemPicker OnSelected="AgregarProducto" Placeholder="@(T("oportunidadmodal.agrega_productos"))" />
        </div>
        @if (Valor.Lineas is { Count: > 0 } lineas)
        {
            <div class="opp-lines">
                @for (var i = 0; i < lineas.Count; i++)
                {
                    var indice = i;
                    var l = lineas[i];
                    <div class="opp-line" @key="indice">
                        <span class="t1">@l.Descripcion</span>
                        <label class="opp-field"><span>@T("oportunidadmodal.cantidad")</span>
                            <input class="control" type="number" min="0" step="any" value="@l.Cantidad" @onchange="e => CambiarLinea(indice, cantidad: e.Value)" /></label>
                        <label class="opp-field"><span>@T("oportunidadmodal.precio")</span>
                            <input class="control" type="number" min="0" step="0.01" value="@l.PrecioUnitario" @onchange="e => CambiarLinea(indice, precio: e.Value)" /></label>
                        <strong class="amount">@Fmt.Amount(l.Total)</strong>
                        <button class="btn btn-ghost icon-btn sm" @onclick="() => lineas.RemoveAt(indice)" aria-label="@(T("oportunidadmodal.quitar"))"><Icon Name="x" Size="16" /></button>
                    </div>
                }
            </div>
        }
        <div class="form-row three">
            <div class="field">
                <label>@T("oportunidadmodal.monto_estimado", Fmt.Symbol(Fmt.Currency))</label>
                <input class="control" type="number" min="0" step="0.01" disabled="@(Valor.Lineas is { Count: > 0 })" value="@MontoVisible" @onchange="e => Valor.Monto = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var m) ? m : Valor.Monto" />
            </div>
            <div class="field">
                <label>@T("oportunidadmodal.etapa")</label>
                <select class="select" @bind="_etapa">
                    @foreach (var e in _embudo.Etapas)
                    {
                        <option value="@e.Id">@Embudo.NombreDe(e) (@e.Probabilidad %)</option>
                    }
                    <option value="@nameof(EtapaOportunidad.Ganado)">@Fmt.Stage(EtapaOportunidad.Ganado)</option>
                    <option value="@nameof(EtapaOportunidad.Perdido)">@Fmt.Stage(EtapaOportunidad.Perdido)</option>
                </select>
            </div>
            <div class="field">
                <label>@T("oportunidadmodal.cierre_estimado")</label>
                <input class="control" type="date" @bind="Valor.FechaCierreEstimada" />
            </div>
        </div>
        <div class="form-row">
            <div class="field">
                <label>@T("oportunidadmodal.competidor_opcional")</label>
                <input class="control" placeholder="@(T("oportunidadmodal.contra_quien_compites"))" @bind="Valor.Competidor" />
            </div>
            @if (_etapa == nameof(EtapaOportunidad.Perdido))
            {
                <div class="field">
                    <label>@T("oportunidadmodal.por_que_se_perdio")</label>
                    <select class="select" @bind="Valor.MotivoPerdida">
                        <option value="">@T("oportunidadmodal.elige_el_motivo")</option>
                        @foreach (var m in Motivos)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="field">
            <label>@T("oportunidadmodal.notas")</label>
            <textarea class="control" rows="3" @bind="Valor.Notas"></textarea>
        </div>
        @if (!Nueva)
        {
            <CamposPersonalizados Entidad="@EntidadesCampo.Oportunidad" RegistroId="Valor.Id" Tarjeta="false" />
        }
    </ChildContent>
    <Footer>
        @if (!Nueva && Session.Can(CrmPermissions.Delete))
        {
            <button class="btn btn-danger" style="margin-right:auto" @onclick="EliminarAsync"><Icon Name="trash" Size="16" />@T("oportunidadmodal.eliminar")</button>
        }
        @if (!Nueva && Valor.Etapa.EstaAbierta() && Session.Can(CrmPermissions.Sell))
        {
            <button class="btn btn-ghost" @onclick="() => _secuencia = true"><Icon Name="play" Size="16" />@T("secuenciamodal.iniciar_secuencia")</button>
        }
        <button class="btn" @onclick="OnClose">@T("oportunidadmodal.cancelar")</button>
        <button class="btn btn-dark" disabled="@_busy" @onclick="GuardarAsync">@T("oportunidadmodal.guardar")</button>
    </Footer>
</Modal>

@if (_secuencia)
{
    <SecuenciaModal OportunidadId="Valor.Id" Nombre="@Valor.Titulo" OnClose="() => _secuencia = false" />
}

@code {
    [Parameter, EditorRequired] public Oportunidad Valor { get; set; } = null!;
    [Parameter] public bool Nueva { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private IReadOnlyList<Option> _clientes = [], _contactos = [];
    private bool _secuencia;
    private IReadOnlyList<Embudo> _embudos = [];
    private Embudo _embudo = Embudo.Predeterminado;
    private IReadOnlyList<string> _motivos = [];
    private string _etapa = "";
    private string? _error;
    private bool _busy;

    private CrmWorkspace Crm => Session.Workspace!;

    /// <summary>Los motivos de la lista y, si la oportunidad ya tenía otro, también ese.</summary>
    private IEnumerable<string> Motivos => Valor.MotivoPerdida is { Length: > 0 } m && !_motivos.Contains(m) ? _motivos.Append(m) : _motivos;

    protected override async Task OnInitializedAsync()
    {
        _embudos = await Crm.Embudos.ListarAsync();
        _embudo = Valor.EmbudoId is { } id ? await Crm.Embudos.ObtenerAsync(id) : _embudos.FirstOrDefault(e => e.PorDefecto) ?? _embudos[0];
        if (!_embudos.Contains(_embudo))
            _embudos = [.. _embudos, _embudo];   // un embudo archivado sigue disponible para sus oportunidades
        _etapa = Valor.Etapa.EstaAbierta()
            ? (_embudo.Etapa(Valor.EtapaId) ?? _embudo.PrimeraQueEquivale(Valor.Etapa) ?? _embudo.Etapas[0]).Id.ToString()
            : Valor.Etapa.ToString();
        _motivos = (await Crm.Clientes.ObtenerAjustesAsync()).Motivos;
        _clientes = await Crm.Master.GetPartyOptionsAsync(suppliers: false);
        await CargarContactosAsync();
        // La lista del pipeline no trae los productos: se cargan para no perderlos al guardar.
        if (!Nueva && Valor.Lineas is null)
            Valor.Lineas = (await Crm.Oportunidades.ObtenerAsync(Valor.Id))?.Lineas;
    }

    /// <summary>Con productos, el monto es su suma.</summary>
    private decimal MontoVisible => Valor.Lineas is { Count: > 0 } l ? l.Sum(x => x.Total) : Valor.Monto;

    private void AgregarProducto(ItemRow item)
    {
        Valor.Lineas ??= [];
        var i = Valor.Lineas.FindIndex(l => l.ItemId == item.Id);
        if (i >= 0)
            Valor.Lineas[i] = Valor.Lineas[i] with { Cantidad = Valor.Lineas[i].Cantidad + 1 };
        else
            Valor.Lineas.Add(new LineaOportunidad(item.Id, item.Name, 1, item.Price));
    }

    private void CambiarLinea(int indice, object? cantidad = null, object? precio = null)
    {
        if (Valor.Lineas is not { } lineas || indice >= lineas.Count)
            return;
        static decimal? Leer(object? v) => decimal.TryParse(v?.ToString(), System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;
        var l = lineas[indice];
        lineas[indice] = l with { Cantidad = Leer(cantidad) ?? l.Cantidad, PrecioUnitario = Leer(precio) ?? l.PrecioUnitario };
    }

    private void ElegirEmbudo(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id) || _embudos.FirstOrDefault(x => x.Id == id) is not { } embudo)
            return;
        _embudo = embudo;
        if (Guid.TryParse(_etapa, out _))
            _etapa = embudo.Etapas[0].Id.ToString();
    }

    private async Task ElegirClienteAsync(ChangeEventArgs e)
    {
        Valor.ClienteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        Valor.ContactoId = null;
        await CargarContactosAsync();
    }

    private async Task CargarContactosAsync() =>
        _contactos = Valor.ClienteId is null ? [] : await Crm.Contactos.OpcionesAsync(Valor.ClienteId);

    private async Task GuardarAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            Valor.EmbudoId = _embudo.EsPredeterminado ? null : _embudo.Id;
            if (Guid.TryParse(_etapa, out var etapaId) && _embudo.Etapa(etapaId) is { } etapa)
            {
                Valor.CambiarEtapa(etapa.Equivale, DateTimeOffset.UtcNow);
                Valor.EtapaId = etapa.Id;
            }
            else if (Enum.TryParse<EtapaOportunidad>(_etapa, out var cerrada))
            {
                Valor.CambiarEtapa(cerrada, DateTimeOffset.UtcNow);
            }
            await Crm.Oportunidades.GuardarAsync(Valor);
            Session.NotifyLocalChange();
            await OnSaved.InvokeAsync();
        }
        catch (CrmValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EliminarAsync()
    {
        await Crm.Oportunidades.EliminarAsync(Valor.Id);
        Session.NotifyLocalChange();
        await OnSaved.InvokeAsync();
    }
}
