@inject AppSession Session
@* Alta y edición de una tarea de seguimiento. *@
<Modal Title="@(Nueva ? T("tareamodal.nueva_tarea") : T("tareamodal.editar_tarea"))" Subtitle="@(T("tareamodal.responsable", (Valor.ResponsableNombre ?? Session.UserName)))" Error="@_error" OnClose="OnClose">
    <ChildContent>
        <div class="field">
            <label>@T("tareamodal.que_hay_que_hacer")</label>
            <input class="control" placeholder="@(T("tareamodal.llamar_para_confirmar_el_pedido"))" @bind="Valor.Titulo" />
        </div>
        <div class="segmented" style="flex-wrap:wrap">
            @foreach (var t in TiposTarea.Todos)
            {
                <button class="@(Valor.Tipo == t ? "on" : "")" @onclick="() => Valor.Tipo = t"><Icon Name="@Fmt.TaskIcon(t)" Size="15" />@Fmt.TaskType(t)</button>
            }
        </div>
        <div class="form-row three">
            <div class="field">
                <label>@T("tareamodal.fecha")</label>
                <input class="control" type="date" @bind="Valor.Fecha" />
            </div>
            <div class="field">
                <label>@T("tareamodal.hora_opcional")</label>
                <input class="control" type="time" @bind="Valor.Hora" />
            </div>
            <div class="field">
                <label>@T("tareamodal.aviso")</label>
                <select class="select" value="@(Valor.AvisarMinutosAntes?.ToString() ?? "")" @onchange="e => Valor.AvisarMinutosAntes = int.TryParse(e.Value?.ToString(), out var m) ? m : null">
                    <option value="">@T("tareamodal.sin_aviso")</option>
                    @foreach (var a in Avisos.Para(Valor.Hora))
                    {
                        <option value="@a.MinutosAntes">@a.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="field">
                <label>@T("tareamodal.cliente_opcional")</label>
                <select class="select" @bind="Valor.ClienteId">
                    <option value="">@T("tareamodal.sin_cliente")</option>
                    @foreach (var c in _clientes)
                    {
                        <option value="@c.Id">@c.Label</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>@T("tareamodal.oportunidad_opcional")</label>
                <select class="select" @bind="Valor.OportunidadId">
                    <option value="">@T("tareamodal.sin_oportunidad")</option>
                    @foreach (var o in _oportunidades)
                    {
                        <option value="@o.Id">@o.Label</option>
                    }
                </select>
            </div>
        </div>
        <div class="field">
            <label>@T("tareamodal.notas")</label>
            <textarea class="control" rows="2" @bind="Valor.Notas"></textarea>
        </div>
        @if (_sinPermiso)
        {
            <div class="alert warn"><Icon Name="bell" Size="18" /><span>@T("tareamodal.sin_permiso_para_notificaciones_el")</span></div>
        }
    </ChildContent>
    <Footer>
        @if (!Nueva && (Valor.ResponsableId == Session.UserId || Session.Can(CrmPermissions.Delete)))
        {
            <button class="btn btn-danger" style="margin-right:auto" @onclick="EliminarAsync"><Icon Name="trash" Size="16" />@T("tareamodal.eliminar")</button>
        }
        <button class="btn" @onclick="OnClose">@T("tareamodal.cancelar")</button>
        <button class="btn btn-dark" disabled="@_busy" @onclick="GuardarAsync">@T("tareamodal.guardar")</button>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public Tarea Valor { get; set; } = null!;
    [Parameter] public bool Nueva { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Inject] private IServicioRecordatorios Recordatorios { get; set; } = null!;

    private IReadOnlyList<Option> _clientes = [], _oportunidades = [];
    private string? _error;
    private bool _busy, _sinPermiso;

    private CrmWorkspace Crm => Session.Workspace!;

    protected override async Task OnInitializedAsync()
    {
        _clientes = await Crm.Master.GetPartyOptionsAsync(suppliers: false);
        _oportunidades = await Crm.Oportunidades.OpcionesAsync(null);
    }

    private async Task GuardarAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (Valor.AvisarMinutosAntes is not null && Recordatorios.Disponible)
                _sinPermiso = !await Recordatorios.SolicitarPermisoAsync();
            await Crm.Tareas.GuardarAsync(Valor);
            Session.NotifyLocalChange();
            await OnSaved.InvokeAsync();
        }
        catch (CrmValidationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EliminarAsync()
    {
        await Crm.Tareas.EliminarAsync(Valor.Id);
        Session.NotifyLocalChange();
        await OnSaved.InvokeAsync();
    }
}
