@* Estado con punto + texto (el color nunca va solo). Tonos: good, info, warn, bad, neutral, accent. *@
<span class="pill @Tone @(Plain ? "plain" : "")">@Text</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public bool Plain { get; set; }

    public static (string Text, string Tone) ForEtapa(EtapaOportunidad etapa) => (Fmt.Stage(etapa), etapa switch
    {
        EtapaOportunidad.Prospecto => "neutral",
        EtapaOportunidad.Cotizado => "info",
        EtapaOportunidad.Negociacion => "warn",
        EtapaOportunidad.Ganado => "good",
        _ => "bad",
    });

    public static (string Text, string Tone) ForCotizacion(CotizacionVista q, DateOnly hoy) =>
        q.PedidoId is not null ? (T("statuspill.con_pedido"), "good")
        : q.Vencida(hoy) ? (T("statuspill.vencida"), "bad")
        : ForEstado(q.Estado);

    public static (string Text, string Tone) ForEstado(EstadoCotizacion estado) => estado switch
    {
        EstadoCotizacion.Borrador => (Fmt.QuoteStatus(EstadoCotizacion.Borrador), "neutral"),
        EstadoCotizacion.Enviada => (Fmt.QuoteStatus(EstadoCotizacion.Enviada), "info"),
        EstadoCotizacion.Aceptada => (Fmt.QuoteStatus(EstadoCotizacion.Aceptada), "good"),
        _ => (Fmt.QuoteStatus(EstadoCotizacion.Rechazada), "bad"),
    };
}
